<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>User Withdrawals</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:'Inter',sans-serif;
    background:#f6f8fb;
    color:#1e293b;
    min-height:100vh;
    overflow-x:hidden;
}

/* BACKGROUND */

.bg{
    position:fixed;
    border-radius:50%;
    filter:blur(90px);
    opacity:.45;
    z-index:0;
    pointer-events:none;
}

.bg1{
    width:320px;
    height:320px;
    background:#c7d2fe;
    top:-100px;
    left:-100px;
}

.bg2{
    width:320px;
    height:320px;
    background:#fde68a;
    bottom:-100px;
    right:-100px;
}

/* CONTAINER */

.container{
    position:relative;
    z-index:2;
    max-width:1300px;
    margin:auto;
    padding:30px 20px;
}

/* HEADER */

.top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
    margin-bottom:25px;
    flex-wrap:wrap;
}

.title h1{
    font-size:34px;
    color:#0f172a;
    margin-bottom:8px;
}

.title p{
    color:#64748b;
    font-size:14px;
}

/* SUMMARY */

.summary{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
    gap:20px;
    margin-bottom:25px;
}

.summary-card{
    background:rgba(255,255,255,0.82);
    backdrop-filter:blur(18px);
    border:1px solid rgba(255,255,255,0.7);
    border-radius:28px;
    padding:28px;
    box-shadow:
        0 20px 40px rgba(15,23,42,0.06),
        0 2px 10px rgba(15,23,42,0.04);
}

.summary-card h3{
    color:#64748b;
    font-size:14px;
    margin-bottom:10px;
}

.summary-card p{
    font-size:34px;
    font-weight:700;
    color:#0f172a;
}

/* TABLE */

.table-wrapper{
    background:rgba(255,255,255,0.82);
    backdrop-filter:blur(20px);
    border-radius:28px;
    overflow:hidden;
    border:1px solid rgba(255,255,255,0.7);
    box-shadow:
        0 20px 40px rgba(15,23,42,0.06),
        0 2px 10px rgba(15,23,42,0.04);
}

.table-scroll{
    overflow-x:auto;
}

table{
    width:100%;
    border-collapse:collapse;
    min-width:850px;
}

thead{
    background:#eef2ff;
}

th{
    text-align:left;
    padding:18px;
    font-size:13px;
    color:#4f46e5;
}

td{
    padding:18px;
    border-top:1px solid #f1f5f9;
    font-size:14px;
    color:#334155;
}

tr:hover{
    background:#f8fafc;
}

/* STATUS */

.status{
    display:inline-block;
    padding:8px 16px;
    border-radius:999px;
    font-size:12px;
    font-weight:600;
}

.pending{
    background:#fef3c7;
    color:#b45309;
}

.success{
    background:#dcfce7;
    color:#15803d;
}

.failed{
    background:#fee2e2;
    color:#dc2626;
}

/* MOBILE */

@media(max-width:700px){

    .container{
        padding:20px 14px;
    }

    .title h1{
        font-size:28px;
    }

    .summary-card{
        padding:22px;
    }

    .summary-card p{
        font-size:28px;
    }

}

</style>

</head>

<body>

<div class="bg bg1"></div>
<div class="bg bg2"></div>

<div class="container">

    <!-- HEADER -->

    <div class="top">

        <div class="title">

            <h1>Your Withdrawals</h1>

            <p>
                View all withdrawal requests and statuses
            </p>

        </div>

    </div>

    <!-- SUMMARY -->

    <div class="summary">

        <div class="summary-card">

            <h3>Total Withdrawals</h3>

            <p>
                <%= withdrawals.length %>
            </p>

        </div>

        <div class="summary-card">

            <h3>Total Amount</h3>

            <p>

                ₹<%= withdrawals.reduce((sum, withdrawal) => {

                    return sum + Number(withdrawal.transfer_amount || 0);

                },0).toFixed(2) %>

            </p>

        </div>

    </div>

    <!-- TABLE -->

    <div class="table-wrapper">

        <div class="table-scroll">

            <table>

                <thead>

                    <tr>

                        <th>Transfer ID</th>
                        <th>Amount</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Status</th>

                    </tr>

                </thead>

                <tbody>

                    <% withdrawals.forEach(function(withdrawal) { %>

                        <tr>

                            <td>
                                <%= withdrawal.transfer_id %>
                            </td>

                            <td>
                                ₹<%= withdrawal.transfer_amount %>
                            </td>

                            <td>

                                <%

                                    const utcDate =
                                        new Date(withdrawal.created_at);

                                    const istOffset =
                                        5.5 * 60;

                                    const istTime =
                                        new Date(
                                            utcDate.getTime() +
                                            (istOffset * 60 * 1000)
                                        );

                                    const formattedIST =
                                        istTime.toLocaleDateString();

                                %>

                                <%= formattedIST %>

                            </td>

                            <td>

                                <%

                                    const formattedTime =
                                        istTime.toLocaleTimeString([], {
                                            hour:'2-digit',
                                            minute:'2-digit'
                                        });

                                %>

                                <%= formattedTime %>

                            </td>

                            <td>

                                <div class="status <%= withdrawal.status.toLowerCase() %>">

                                    <%= withdrawal.status === 'PENDING'
                                        ? 'In Process'
                                        : withdrawal.status
                                    %>

                                </div>

                            </td>

                        </tr>

                    <% }); %>

                </tbody>

            </table>

        </div>

    </div>

</div>

</body>

</html>