<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>QR Code Batches</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<style>

/* ===== BASE ===== */
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:'Inter',sans-serif;
    background:#f6f8fb;
    color:#1e293b;
    min-height:100dvh;
    overflow-x:hidden;
}

/* ===== BACKGROUND ===== */
.bg{
    position:fixed;
    border-radius:50%;
    filter:blur(80px);
    opacity:.45;
    z-index:0;
    pointer-events:none;
}

.bg1{
    width:320px;
    height:320px;
    background:#c7d2fe;
    top:-100px;
    left:-100px;
}

.bg2{
    width:340px;
    height:340px;
    background:#fde68a;
    bottom:-100px;
    right:-100px;
}

/* ===== CONTAINER ===== */
.container{
    position:relative;
    z-index:2;
    max-width:1400px;
    margin:auto;
    padding:30px 20px;
}

/* ===== HEADER ===== */
.top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
    margin-bottom:30px;
    flex-wrap:wrap;
}

.title h1{
    font-size:34px;
    color:#0f172a;
    margin-bottom:8px;
}

.title p{
    color:#64748b;
    font-size:14px;
}

/* ===== SEARCH ===== */
.search-bar{
    display:flex;
    gap:12px;
    flex-wrap:wrap;
}

.search-bar input{
    width:320px;
    max-width:100%;
    height:54px;
    border-radius:18px;
    border:1px solid #e2e8f0;
    background:rgba(255,255,255,0.85);
    padding:0 18px;
    font-size:14px;
    outline:none;
    transition:.25s;
    backdrop-filter:blur(12px);
}

.search-bar input:focus{
    border-color:#a5b4fc;
    box-shadow:0 0 0 4px rgba(99,102,241,.08);
}

.search-bar button{
    height:54px;
    padding:0 22px;
    border:none;
    border-radius:18px;
    background:linear-gradient(135deg,#818cf8,#6366f1);
    color:white;
    font-weight:600;
    cursor:pointer;
    transition:.25s;
    box-shadow:0 10px 20px rgba(99,102,241,.15);
}

.search-bar button:hover{
    transform:translateY(-2px);
}

/* ===== GRID ===== */
.batch-list{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(340px,1fr));
    gap:20px;
}

/* ===== CARD ===== */
.batch-card{
    background:rgba(255,255,255,0.8);
    backdrop-filter:blur(18px);
    border:1px solid rgba(255,255,255,0.7);
    border-radius:28px;
    padding:24px;
    box-shadow:
        0 20px 40px rgba(15,23,42,0.06),
        0 2px 10px rgba(15,23,42,0.04);
    transition:.25s;
    position:relative;
    overflow:hidden;
}

.batch-card::before{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(135deg,#eef2ff,#ffffff);
    opacity:.7;
    z-index:-1;
}

.batch-card:hover{
    transform:translateY(-4px);
}

/* ===== BADGE ===== */
.batch-badge{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:10px 16px;
    border-radius:999px;
    background:#eef2ff;
    color:#4f46e5;
    font-size:13px;
    font-weight:600;
    margin-bottom:20px;
}

/* ===== PAGINATION ===== */

.pagination{
    display:flex;
    gap:10px;
    justify-content:center;
    margin-top:30px;
    flex-wrap:wrap;
}

.pagination a{
    padding:10px 14px;
    background:white;
    border:1px solid #e2e8f0;
    border-radius:10px;
    text-decoration:none;
    color:#334155;
    font-size:14px;
    transition:0.2s;
}

.pagination a:hover{
    background:#eef2ff;
    color:#4f46e5;
}

.active-page{
    background:#4f46e5 !important;
    color:white !important;
    border-color:#4f46e5 !important;
}

/* ===== INFO ===== */
.batch-info{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
    margin-bottom:24px;
}

.info-box{
    background:#ffffffcc;
    border:1px solid #e2e8f0;
    border-radius:18px;
    padding:16px;
}

.info-box small{
    display:block;
    color:#64748b;
    font-size:12px;
    margin-bottom:8px;
}

.info-box span{
    font-size:15px;
    font-weight:600;
    color:#0f172a;
    word-break:break-word;
}

/* ===== BUTTONS ===== */
.buttons{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:12px;
}

.btn{
    height:50px;
    border:none;
    border-radius:16px;
    font-size:14px;
    font-weight:600;
    cursor:pointer;
    transition:.25s;
}

.view-btn{
    background:#eef2ff;
    color:#4f46e5;
}

.download-btn{
    background:#dcfce7;
    color:#15803d;
}

.edit-btn{
    background:#fef3c7;
    color:#b45309;
}

.delete-btn{
    background:#fee2e2;
    color:#dc2626;
}

.btn:hover{
    transform:translateY(-2px);
}

/* ===== SEARCH RESULT ===== */
.search-result{
    margin-top:30px;
    background:rgba(255,255,255,0.82);
    backdrop-filter:blur(20px);
    border-radius:28px;
    padding:28px;
    border:1px solid rgba(255,255,255,0.7);
    box-shadow:
        0 20px 40px rgba(15,23,42,0.06),
        0 2px 10px rgba(15,23,42,0.04);
}

.search-result h2{
    margin-bottom:20px;
    color:#0f172a;
}

.qr-details{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
    gap:14px;
}

.qr-details p{
    background:#ffffffcc;
    border:1px solid #e2e8f0;
    border-radius:18px;
    padding:16px;
    font-size:14px;
    line-height:1.6;
}

/* ===== MOBILE ===== */
@media(max-width:900px){

    .batch-list{
        grid-template-columns:1fr;
    }

}

@media(max-width:600px){

    .container{
        padding:20px 14px;
    }

    .top{
        align-items:flex-start;
    }

    .title h1{
        font-size:28px;
    }

    .search-bar{
        width:100%;
    }

    .search-bar input{
        width:100%;
    }

    .search-bar button{
        width:100%;
    }

    .batch-card{
        padding:20px;
        border-radius:24px;
    }

    .batch-info{
        grid-template-columns:1fr;
    }

    .buttons{
        grid-template-columns:1fr;
    }

}

</style>

</head>

<body>

<div class="bg bg1"></div>
<div class="bg bg2"></div>

<div class="container">

    <!-- HEADER -->
    <div class="top">

        <div class="title">
            <h1>QR Code Batches</h1>
            <p>
                Manage, edit and download generated QR batches
            </p>
        </div>

        <div class="search-bar">

            <input
                type="text"
                id="searchInput"
                placeholder="Search Batch ID..."
                onkeyup="searchQRCode()"
            >

            <button onclick="searchQRCode()">
                Search
            </button>

        </div>

    </div>

    <!-- BATCHES -->
    <div class="batch-list" id="batchList">

        <% qrBatches.forEach(function(batch) { %>

        <div class="batch-card" data-id="<%= batch.id %>">

            <div class="batch-badge">
                <i class="fas fa-qrcode"></i>
                <%= batch.id %>
            </div>

            <div class="batch-info">

                <div class="info-box">
                    <small>Created At</small>
                    <span><%= batch.createdAt %></span>
                </div>

                <div class="info-box">
                    <small>Points</small>
                    <span><%= batch.points %></span>
                </div>

                <div class="info-box">
                    <small>Total Coupons</small>
                    <span><%= batch.couponCount %></span>
                </div>

                <div class="info-box">
                    <small>Status</small>
                    <span>Active</span>
                </div>

            </div>

            <div class="buttons">

                <button
                    class="btn view-btn"
                    onclick="viewBatch('<%= batch.id %>')"
                >
                    View
                </button>

                <button
                    class="btn download-btn"
                    onclick="downloadBatch('<%= batch.id %>')"
                >
                    Download
                </button>

                <button
                    class="btn edit-btn"
                    onclick="editBatch('<%= batch.id %>')"
                >
                    Edit
                </button>

                <button
                    class="btn delete-btn"
                    onclick="deleteBatch('<%= batch.id %>')"
                >
                    Delete
                </button>

            </div>

        </div>
        
        <% }); %>

    </div>

    <!-- PAGINATION -->
<div class="pagination">

    <% if(currentPage > 1){ %>
        <a href="/admin/view-qr?page=<%= currentPage - 1 %>">
            Previous
        </a>
    <% } %>

    <% for(let i = 1; i <= totalPages; i++){ %>

        <a 
            href="/admin/view-qr?page=<%= i %>"
            class="<%= currentPage === i ? 'active-page' : '' %>"
        >
            <%= i %>
        </a>

    <% } %>

    <% if(currentPage < totalPages){ %>
        <a href="/admin/view-qr?page=<%= currentPage + 1 %>">
            Next
        </a>
    <% } %>

</div>

    <!-- SEARCH RESULT -->
    <div id="searchResult" class="search-result" style="display:none;">

        <h2>QR Code Details</h2>

        <div class="qr-details">

            <p><strong>QR Code:</strong> <span id="qrCodeValue"></span></p>

            <p><strong>Batch:</strong> <span id="qrBatchValue"></span></p>

            <p><strong>Points:</strong> <span id="qrPoints"></span></p>

            <p><strong>Status:</strong> <span id="qrStatus"></span></p>

            <p><strong>Scanned By:</strong> <span id="scannedBy"></span></p>

            <p><strong>Created At:</strong> <span id="qrCreatedAt"></span></p>

        </div>

    </div>

</div>

<script>

// SEARCH
// SEARCH
function searchQRCode(){

    const code = document
        .getElementById("searchInput")
        .value
        .trim()
        .toUpperCase();

    const batches =
        document.querySelectorAll(".batch-card");

    batches.forEach(batch => {

        const batchId = batch
            .getAttribute("data-id")
            .toUpperCase();

        if(batchId.includes(code)){

            batch.style.display = "";

        } else {

            batch.style.display = "none";

        }

    });

}

// VIEW
function viewBatch(batchId){

    window.location.href =
        `/admin/view-qr/${batchId}`;

}

// DOWNLOAD
function downloadBatch(batchId){

    window.location.href =
        `/admin/download-batch/${batchId}`;

}

// EDIT
function editBatch(batchId){

    const newPoints =
        prompt("Enter new points for this batch:");

    if(newPoints){

        fetch(`/admin/edit-batch/${batchId}`,{
            method:"PUT",
            headers:{
                "Content-Type":"application/json"
            },
            body:JSON.stringify({
                points:newPoints
            })
        })
        .then(()=>{

            alert("Batch updated successfully");

            location.reload();

        });

    }

}

// DELETE
function deleteBatch(batchId){

    const password =
        prompt("Enter password to delete batch");

    if(password === null || password === ""){
        return;
    }

    fetch(`/admin/delete-batch/${batchId}`,{
        method:'DELETE',
        headers:{
            'Content-Type':'application/json',
        },
        body:JSON.stringify({ password })
    })
    .then(response => response.json())
    .then(data => {

        alert(data.message);

        location.reload();

    })
    .catch(error => {

        console.error(error);

        alert("Failed to delete batch.");

    });

}

</script>

</body>
</html>