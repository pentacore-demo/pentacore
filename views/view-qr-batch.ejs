<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>QR Codes - <%= batchId %></title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<style>

/* ===== BASE ===== */
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:'Inter',sans-serif;
    background:#f6f8fb;
    color:#1e293b;
    min-height:100vh;
    overflow-x:hidden;
}

/* ===== BG ===== */
.bg{
    position:fixed;
    border-radius:50%;
    filter:blur(90px);
    opacity:.45;
    z-index:0;
    pointer-events:none;
}

.bg1{
    width:320px;
    height:320px;
    background:#c7d2fe;
    top:-100px;
    left:-100px;
}

.bg2{
    width:340px;
    height:340px;
    background:#fde68a;
    bottom:-100px;
    right:-100px;
}

/* ===== CONTAINER ===== */
.container{
    position:relative;
    z-index:2;
    max-width:1400px;
    margin:auto;
    padding:30px 20px;
}

/* ===== HEADER ===== */
.top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
    margin-bottom:30px;
    flex-wrap:wrap;
}

.title h1{
    font-size:34px;
    color:#0f172a;
    margin-bottom:8px;
}

.title p{
    color:#64748b;
    font-size:14px;
}

/* ===== SEARCH ===== */
.search-bar{
    display:flex;
    gap:12px;
    flex-wrap:wrap;
}

.search-bar input{
    width:320px;
    max-width:100%;
    height:54px;
    border-radius:18px;
    border:1px solid #e2e8f0;
    background:rgba(255,255,255,0.85);
    padding:0 18px;
    font-size:14px;
    outline:none;
    transition:.25s;
    backdrop-filter:blur(12px);
}

.search-bar input:focus{
    border-color:#a5b4fc;
    box-shadow:0 0 0 4px rgba(99,102,241,.08);
}

.search-bar button{
    height:54px;
    width:54px;
    border:none;
    border-radius:18px;
    background:linear-gradient(135deg,#818cf8,#6366f1);
    color:white;
    cursor:pointer;
    font-size:16px;
    transition:.25s;
    box-shadow:0 10px 20px rgba(99,102,241,.15);
}

.search-bar button:hover{
    transform:translateY(-2px);
}

/* ===== TABLE ===== */
.qr-table{
    background:rgba(255,255,255,0.8);
    backdrop-filter:blur(18px);
    border-radius:28px;
    overflow:hidden;
    border:1px solid rgba(255,255,255,0.7);
    box-shadow:
        0 20px 40px rgba(15,23,42,0.06),
        0 2px 10px rgba(15,23,42,0.04);
}

/* ===== HEADER ===== */
.qr-header{
    display:grid;
    grid-template-columns:2fr 1fr 1fr 1fr;
    background:#eef2ff;
    padding:18px 20px;
    font-weight:600;
    color:#4f46e5;
    gap:12px;
}

/* ===== ROW ===== */
.qr-row{
    display:grid;
    grid-template-columns:2fr 1fr 1fr 1fr;
    gap:12px;
    padding:18px 20px;
    border-top:1px solid #e2e8f0;
    align-items:center;
    transition:.2s;
}

.qr-row:hover{
    background:#f8fafc;
}

.qr-col{
    word-break:break-word;
    font-size:14px;
}

/* ===== STATUS ===== */
.status-scanned{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:8px 14px;
    border-radius:999px;
    background:#dcfce7;
    color:#15803d;
    font-size:13px;
    font-weight:600;
}

.status-not-scanned{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:8px 14px;
    border-radius:999px;
    background:#fee2e2;
    color:#dc2626;
    font-size:13px;
    font-weight:600;
}

/* ===== ACTIONS ===== */
.actions{
    display:flex;
    align-items:center;
    gap:14px;
}

.actions i{
    width:42px;
    height:42px;
    border-radius:14px;
    display:flex;
    align-items:center;
    justify-content:center;
    cursor:pointer;
    transition:.25s;
    font-size:15px;
}

.fa-edit{
    background:#fef3c7;
    color:#b45309;
}

.fa-toggle-on,
.fa-toggle-off{
    background:#eef2ff;
    color:#4f46e5;
}

.fa-qrcode{
    background:#dcfce7;
    color:#15803d;
}

.actions i:hover{
    transform:translateY(-2px);
}

/* ===== BACK BUTTON ===== */
.back-button{
    margin-top:25px;
}

.back-button button{
    height:54px;
    padding:0 24px;
    border:none;
    border-radius:18px;
    background:linear-gradient(135deg,#818cf8,#6366f1);
    color:white;
    font-weight:600;
    cursor:pointer;
    transition:.25s;
    box-shadow:0 10px 20px rgba(99,102,241,.15);
}

.back-button button:hover{
    transform:translateY(-2px);
}

/* ===== MOBILE ===== */
@media(max-width:900px){

    .qr-header{
        display:none;
    }

    .qr-row{
        grid-template-columns:1fr;
        background:white;
        margin:14px;
        border-radius:22px;
        border:1px solid #e2e8f0;
    }

    .qr-col{
        display:flex;
        flex-direction:column;
        gap:6px;
    }

    .qr-col::before{
        font-size:12px;
        color:#64748b;
        font-weight:600;
    }

    .qr-row .qr-col:nth-child(1)::before{
        content:"QR Code";
    }

    .qr-row .qr-col:nth-child(2)::before{
        content:"Points";
    }

    .qr-row .qr-col:nth-child(3)::before{
        content:"Status";
    }

    .qr-row .qr-col:nth-child(4)::before{
        content:"Actions";
    }

}

@media(max-width:600px){

    .container{
        padding:20px 14px;
    }

    .top{
        align-items:flex-start;
    }

    .title h1{
        font-size:28px;
    }

    .search-bar{
        width:100%;
    }

    .search-bar input{
        width:100%;
    }

    .actions{
        flex-wrap:wrap;
    }

}

</style>

</head>

<body>

<div class="bg bg1"></div>
<div class="bg bg2"></div>

<div class="container">

    <!-- HEADER -->
    <div class="top">

        <div class="title">
            <h1><%= batchId %></h1>
            <p>
                Manage QR codes inside this batch
            </p>
        </div>

        <div class="search-bar">

            <input
                type="text"
                id="searchInput"
                placeholder="Search QR Code..."
                onkeyup="searchQR()"
            >

            <button onclick="searchQR()">
                <i class="fas fa-search"></i>
            </button>

        </div>

    </div>

    <!-- TABLE -->
    <div class="qr-table">

        <div class="qr-header">

            <div>QR Code</div>
            <div>Points</div>
            <div>Status</div>
            <div>Actions</div>

        </div>

        <% qrCodes.forEach(function(qr) { %>

        <div class="qr-row">

            <div class="qr-col">
                <%= qr.code %>
            </div>

            <div class="qr-col">
                <%= qr.points %>
            </div>

            <div class="qr-col">

                <span class="<%= qr.status === 'Scanned' ? 'status-scanned' : 'status-not-scanned' %>">

                    <%= qr.status %>

                </span>

            </div>

            <div class="qr-col">

                <div class="actions">

                    <i
                        class="fas fa-edit"
                        onclick="editPoints('<%= qr.code %>')"
                    ></i>

                    <i
                        class="<%= qr.status === 'Scanned' ? 'fas fa-toggle-off' : 'fas fa-toggle-on' %>"
                        onclick="toggleActivation('<%= qr.code %>')"
                    ></i>

                    <i
                        class="fas fa-qrcode"
                        onclick="viewQRCode('<%= qr.code %>')"
                    ></i>

                </div>

            </div>

        </div>

        <% }); %>

    </div>

    <!-- BACK -->
    <div class="back-button">

        <button onclick="window.history.back()">
            Back to Batches
        </button>

    </div>

</div>

<script>

function searchQR(){

    const searchInput =
        document
        .getElementById('searchInput')
        .value
        .toLowerCase();

    const rows =
        document.querySelectorAll('.qr-row');

    rows.forEach(row => {

        const qrCode =
            row
            .querySelector('.qr-col')
            .textContent
            .toLowerCase();

        if(qrCode.includes(searchInput)){

            row.style.display = '';

        } else {

            row.style.display = 'none';

        }

    });

}

async function editPoints(qrCode){

    const newPoints =
        prompt("Enter new points for this QR code:");

    if(newPoints){

        try{

            await fetch('/admin/edit-qr/' + qrCode,{

                method:'PUT',

                headers:{
                    'Content-Type':'application/json',
                },

                body:JSON.stringify({
                    points:newPoints
                }),

            });

            const rows =
                document.querySelectorAll('.qr-row');

            rows.forEach(row => {

                const codeCell =
                    row.querySelector('.qr-col');

                if(codeCell.textContent.trim() === qrCode){

                    row.querySelectorAll('.qr-col')[1]
                    .textContent = newPoints;

                }

            });

            alert("Points updated successfully");

        } catch(error){

            alert(
                "Error updating points: " +
                error.message
            );

        }

    }

}

async function toggleActivation(qrCode){

    try{

        const response =
            await fetch(`/admin/toggle-qr-status/${qrCode}`,{

                method:"PUT",

                headers:{
                    "Content-Type":"application/json"
                },

            });

        const data = await response.json();

        if(response.ok){

            alert(
                `QR Code ${qrCode} updated`
            );

            location.reload();

        } else {

            alert("Failed to update QR code status.");

        }

    } catch(error){

        console.error(error);

        alert("Error toggling QR code status.");

    }

}

function viewQRCode(qrCode){

    window.open(
        `/admin/view-qr-image/${qrCode}`,
        "_blank"
    );

}

</script>

</body>
</html>