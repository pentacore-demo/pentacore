<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Schemes</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }

        body{
            font-family:'Inter',sans-serif;
            background:#f4f7fb;
            min-height:100vh;
            padding:30px;
            color:#0f172a;
        }

        .page-header{
            display:flex;
            justify-content:space-between;
            align-items:center;
            margin-bottom:30px;
            flex-wrap:wrap;
            gap:15px;
        }

        .page-title{
            font-size:32px;
            font-weight:700;
            color:#111827;
        }

        .card{
            background:white;
            border-radius:24px;
            padding:24px;
            box-shadow:
            0 10px 30px rgba(15,23,42,0.06);
            margin-bottom:25px;
        }

        .form-title{
            font-size:20px;
            font-weight:600;
            margin-bottom:18px;
        }

        textarea{
            width:100%;
            min-height:130px;
            border:none;
            outline:none;
            resize:none;
            padding:18px;
            border-radius:18px;
            background:#f8fafc;
            font-size:15px;
            font-family:'Inter',sans-serif;
            color:#0f172a;
            border:1px solid #e2e8f0;
            transition:.2s;
        }

        textarea:focus{
            border-color:#4f46e5;
            background:white;
            box-shadow:0 0 0 4px rgba(79,70,229,0.08);
        }

        .submit-btn{
            margin-top:18px;
            border:none;
            background:linear-gradient(
                135deg,
                #6366f1,
                #4f46e5
            );
            color:white;
            padding:14px 22px;
            border-radius:16px;
            font-size:15px;
            font-weight:600;
            cursor:pointer;
            transition:.25s;
            box-shadow:
            0 10px 25px rgba(79,70,229,.18);
        }

        .submit-btn:hover{
            transform:translateY(-2px);
        }

        .notifications-title{
            font-size:22px;
            font-weight:700;
            margin-bottom:20px;
        }

        .notifications-grid{
            display:grid;
            grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
            gap:20px;
        }

        .notification-item{
            background:white;
            border-radius:22px;
            padding:22px;
            position:relative;
            overflow:hidden;
            border:1px solid #edf2f7;
            transition:.25s;
            box-shadow:
            0 8px 24px rgba(15,23,42,0.05);
        }

        .notification-item:hover{
            transform:translateY(-3px);
        }

        .scheme-badge{
            display:inline-block;
            padding:7px 14px;
            border-radius:999px;
            background:#eef2ff;
            color:#4338ca;
            font-size:12px;
            font-weight:600;
            margin-bottom:14px;
        }

        .scheme-text{
            font-size:15px;
            line-height:1.7;
            color:#334155;
            word-break:break-word;
            margin-bottom:20px;
        }

        .scheme-footer{
            display:flex;
            justify-content:space-between;
            align-items:center;
            gap:10px;
        }

        .scheme-date{
            font-size:13px;
            color:#94a3b8;
        }

        .delete-btn{
            border:none;
            background:#fee2e2;
            color:#dc2626;
            padding:10px 16px;
            border-radius:12px;
            font-size:14px;
            font-weight:600;
            cursor:pointer;
            transition:.2s;
        }

        .delete-btn:hover{
            background:#fecaca;
        }

        .empty-box{
            background:white;
            padding:40px;
            border-radius:24px;
            text-align:center;
            color:#64748b;
            box-shadow:
            0 10px 30px rgba(15,23,42,0.05);
        }

        .pagination{
            margin-top:35px;
            display:flex;
            justify-content:center;
            gap:10px;
            flex-wrap:wrap;
        }

        .pagination a{
            min-width:42px;
            height:42px;
            display:flex;
            justify-content:center;
            align-items:center;
            text-decoration:none;
            border-radius:12px;
            background:white;
            color:#334155;
            font-weight:600;
            box-shadow:
            0 5px 15px rgba(15,23,42,0.05);
            transition:.2s;
        }

        .pagination a.active{
            background:#4f46e5;
            color:white;
        }

        .pagination a:hover{
            transform:translateY(-2px);
        }

        @media(max-width:768px){

            body{
                padding:18px;
            }

            .page-title{
                font-size:26px;
            }

            .card{
                padding:18px;
                border-radius:20px;
            }

            .notification-item{
                padding:18px;
                border-radius:18px;
            }

        }

    </style>

</head>

<body>

    <div class="page-header">

        <h1 class="page-title">
            Admin Schemes
        </h1>

    </div>


    <!-- ADD SCHEME -->

    <div class="card">

        <div class="form-title">
            Post New Scheme
        </div>

        <form id="schemeForm">

            <textarea
                name="text"
                id="schemeText"
                placeholder="Write your scheme, offer or announcement..."
                required
            ></textarea>

            <button type="submit" class="submit-btn">
                Post Scheme
            </button>

        </form>

    </div>



    <!-- SCHEMES LIST -->

    <div class="notifications-title">
        All Schemes
    </div>

    <% if (notifications && notifications.length > 0) { %>

        <div class="notifications-grid">

            <% notifications.forEach(function(notification) { %>

                <div class="notification-item">

                    <div class="scheme-badge">
                        SCHEME
                    </div>

                    <div class="scheme-text">
                        <%= notification.text %>
                    </div>

                    <div class="scheme-footer">

                        <div class="scheme-date">

                            <% if(notification.timestamp){ %>

                                <%= new Date(notification.timestamp).toLocaleString() %>

                            <% } %>

                        </div>

                        <button
                            class="delete-btn"
                            data-id="<%= notification.id %>"
                        >
                            Delete
                        </button>

                    </div>

                </div>

            <% }); %>

        </div>

    <% } else { %>

        <div class="empty-box">

            No schemes available.

        </div>

    <% } %>



    <!-- PAGINATION -->

    <% if (totalPages > 1) { %>

        <div class="pagination">

            <% for(let i = 1; i <= totalPages; i++) { %>

                <a
                    href="/admin/admin-scheme?page=<%= i %>"
                    class="<%= currentPage === i ? 'active' : '' %>"
                >
                    <%= i %>
                </a>

            <% } %>

        </div>

    <% } %>




    <script>

        // POST SCHEME

        const schemeForm =
            document.getElementById('schemeForm');

        schemeForm.addEventListener('submit', async function(e){

            e.preventDefault();

            const submitBtn =
                document.querySelector('.submit-btn');

            const textarea =
                document.getElementById('schemeText');

            const text = textarea.value.trim();

            if(!text){

                showToast(
                    'Please enter scheme text',
                    'error'
                );

                return;

            }

            try{

                submitBtn.disabled = true;

                submitBtn.innerText = 'Posting...';

                const response = await fetch(
                    '/admin/post-scheme',
                    {
                        method:'POST',

                        headers:{
                            'Content-Type':'application/json'
                        },

                        body: JSON.stringify({
                            text
                        })
                    }
                );

                const data = await response.json();

                if(data.success){

                    showToast(
                        'Scheme posted successfully',
                        'success'
                    );

                    textarea.value = '';

                    setTimeout(() => {

                        window.location.reload();

                    },1200);

                }else{

                    showToast(
                        'Failed to post scheme',
                        'error'
                    );

                }

            }catch(error){

                showToast(
                    'Server error occurred',
                    'error'
                );

            }finally{

                submitBtn.disabled = false;

                submitBtn.innerText = 'Post Scheme';

            }

        });




        // DELETE SCHEME

        const deleteButtons =
            document.querySelectorAll('.delete-btn');

        deleteButtons.forEach(button => {

            button.addEventListener('click',
            async function() {

                const notificationId =
                    this.getAttribute('data-id');

                const confirmed =
                    confirm('Delete this scheme?');

                if(!confirmed) return;

                try{

                    const response = await fetch(
                        `/admin/delete-scheme/${notificationId}`,
                        {
                            method:'DELETE'
                        }
                    );

                    const data = await response.json();

                    if(data.success){

                        this.closest(
                            '.notification-item'
                        ).remove();

                        showToast(
                            'Scheme deleted successfully',
                            'success'
                        );

                    }else{

                        showToast(
                            'Failed to delete scheme',
                            'error'
                        );

                    }

                }catch(error){

                    showToast(
                        'Error deleting scheme',
                        'error'
                    );

                }

            });

        });




        // TOAST UI

        function showToast(message,type='success'){

            const toast =
                document.createElement('div');

            toast.innerText = message;

            toast.style.position = 'fixed';

            toast.style.top = '25px';

            toast.style.right = '25px';

            toast.style.padding = '14px 22px';

            toast.style.borderRadius = '16px';

            toast.style.fontWeight = '600';

            toast.style.fontSize = '14px';

            toast.style.zIndex = '9999';

            toast.style.color = 'white';

            toast.style.boxShadow =
                '0 10px 25px rgba(0,0,0,0.15)';

            toast.style.transform =
                'translateY(-20px)';

            toast.style.opacity = '0';

            toast.style.transition = '.3s';

            if(type === 'success'){

                toast.style.background =
                    'linear-gradient(135deg,#22c55e,#16a34a)';

            }else{

                toast.style.background =
                    'linear-gradient(135deg,#ef4444,#dc2626)';

            }

            document.body.appendChild(toast);

            setTimeout(()=>{

                toast.style.transform =
                    'translateY(0)';

                toast.style.opacity = '1';

            },50);

            setTimeout(()=>{

                toast.style.transform =
                    'translateY(-20px)';

                toast.style.opacity = '0';

                setTimeout(()=>{

                    toast.remove();

                },300);

            },2500);

        }

    </script>

</body>
</html>