<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Dealer Management</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:'Inter',sans-serif;
    background:#f6f8fb;
    color:#1e293b;
    min-height:100vh;
    overflow-x:hidden;
}

/* BACKGROUND */

.bg{
    position:fixed;
    border-radius:50%;
    filter:blur(90px);
    opacity:.45;
    z-index:0;
    pointer-events:none;
}

.bg1{
    width:320px;
    height:320px;
    background:#c7d2fe;
    top:-100px;
    left:-100px;
}

.bg2{
    width:320px;
    height:320px;
    background:#fde68a;
    bottom:-100px;
    right:-100px;
}

/* CONTAINER */

.container{
    position:relative;
    z-index:2;
    max-width:1300px;
    margin:auto;
    padding:30px 20px;
}

/* HEADER */

.top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
    flex-wrap:wrap;
    margin-bottom:25px;
}

.title h1{
    font-size:34px;
    color:#0f172a;
    margin-bottom:8px;
}

.title p{
    color:#64748b;
    font-size:14px;
}

/* BUTTON */

.btn{
    height:54px;
    padding:0 24px;
    border:none;
    border-radius:18px;
    background:linear-gradient(135deg,#818cf8,#6366f1);
    color:white;
    font-weight:600;
    cursor:pointer;
    transition:.25s;
    font-size:14px;
}

.btn:hover{
    transform:translateY(-2px);
}

/* FORM */

.form-container{
    background:rgba(255,255,255,0.82);
    backdrop-filter:blur(20px);
    border-radius:28px;
    padding:28px;
    margin-bottom:25px;
    border:1px solid rgba(255,255,255,0.7);
    box-shadow:
        0 20px 40px rgba(15,23,42,0.06),
        0 2px 10px rgba(15,23,42,0.04);
}

.form-container h2{
    margin-bottom:24px;
    color:#0f172a;
}

.form-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:18px;
    margin-bottom:20px;
}

.input-group{
    background:#fff;
    border:1px solid #e2e8f0;
    border-radius:20px;
    padding:14px 18px;
}

.input-group label{
    display:block;
    font-size:13px;
    color:#64748b;
    margin-bottom:8px;
}

.input-group input{
    width:100%;
    border:none;
    outline:none;
    background:transparent;
    font-size:15px;
    color:#0f172a;
}

/* TABLE */

.table-wrapper{
    background:rgba(255,255,255,0.82);
    backdrop-filter:blur(20px);
    border-radius:28px;
    overflow:hidden;
    border:1px solid rgba(255,255,255,0.7);
    box-shadow:
        0 20px 40px rgba(15,23,42,0.06),
        0 2px 10px rgba(15,23,42,0.04);
}

.table-header{
    padding:24px 28px;
    border-bottom:1px solid #eef2f7;
}

.table-header h2{
    color:#0f172a;
    font-size:24px;
}

.table-scroll{
    overflow-x:auto;
}

table{
    width:100%;
    border-collapse:collapse;
    min-width:700px;
}

thead{
    background:#eef2ff;
}

th{
    text-align:left;
    padding:18px;
    font-size:13px;
    color:#4f46e5;
}

td{
    padding:18px;
    border-top:1px solid #f1f5f9;
    font-size:14px;
    color:#334155;
}

tr:hover{
    background:#f8fafc;
}

/* BADGE */

.badge{
    display:inline-block;
    padding:8px 14px;
    border-radius:999px;
    background:#eef2ff;
    color:#4f46e5;
    font-size:12px;
    font-weight:600;
}

/* DELETE BUTTON */

.delete-btn{
    background:linear-gradient(135deg,#ef4444,#dc2626);
    height:42px;
    padding:0 18px;
    border-radius:14px;
    font-size:13px;
}

/* MOBILE */

@media(max-width:700px){

    body{
        overflow-x:hidden;
    }

    .container{
        padding:18px 12px;
    }

    .top{
        flex-direction:column;
        align-items:flex-start;
    }

    .title h1{
        font-size:26px;
    }

    .btn{
        width:100%;
    }

    .form-container{
        border-radius:22px;
        padding:20px;
    }

    .form-grid{
        grid-template-columns:1fr;
    }

    .table-wrapper{
        border-radius:22px;
    }

    table{
        min-width:650px;
    }

    th,
    td{
        white-space:nowrap;
        padding:14px;
        font-size:13px;
    }

    .bg1,
    .bg2{
        width:220px;
        height:220px;
    }

}

</style>

</head>

<body>

<div class="bg bg1"></div>
<div class="bg bg2"></div>

<div class="container">

    <!-- HEADER -->

    <div class="top">

        <div class="title">
            <h1>Dealer Management</h1>
            <p>
                Create and manage all dealer accounts
            </p>
        </div>

        <button class="btn" id="createDealerBtn">
            Create New Dealer
        </button>

    </div>

    <!-- CREATE DEALER FORM -->

    <div id="createDealerForm"
         class="form-container"
         style="display:none;">

        <h2>Create New Dealer</h2>

        <form action="/admin/create-dealer" method="POST">

            <div class="form-grid">

                <div class="input-group">

                    <label>User ID</label>

                    <input
                        type="text"
                        id="userId"
                        name="userId"
                        placeholder="Enter User ID"
                        required
                    >

                </div>

                <div class="input-group">

                    <label>Password</label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Enter Password"
                        required
                    >

                </div>

            </div>

            <button type="submit" class="btn">
                Create Dealer
            </button>

        </form>

    </div>

    <!-- DEALERS TABLE -->

    <div class="table-wrapper">

        <div class="table-header">
            <h2>All Dealers</h2>
        </div>

        <div class="table-scroll">

            <table id="dealerList">

                <thead>

                    <tr>
                        <th>User ID</th>
                        <th>Password</th>
                        <th>Actions</th>
                    </tr>

                </thead>

                <tbody>

                    <!-- DEALERS LOAD HERE -->

                </tbody>

            </table>

        </div>

    </div>

</div>

<script>

// TOGGLE CREATE FORM

document
.getElementById("createDealerBtn")
.addEventListener("click", function(){

    const form =
        document.getElementById(
            "createDealerForm"
        );

    form.style.display =
        form.style.display === "none"
            ? "block"
            : "none";

});




// CREATE DEALER WITH MODERN UI

const dealerForm =
    document.querySelector(
        '#createDealerForm form'
    );

dealerForm.addEventListener(
    'submit',
    async function(e){

    e.preventDefault();

    const submitBtn =
        dealerForm.querySelector(
            'button[type="submit"]'
        );

    const userId =
        document.getElementById(
            'userId'
        ).value.trim();

    const password =
        document.getElementById(
            'password'
        ).value.trim();

    if(!userId || !password){

        showToast(
            'Please fill all fields',
            'error'
        );

        return;
    }

    try{

        submitBtn.disabled = true;

        submitBtn.innerText =
            'Creating...';

        const response = await fetch(
            '/admin/create-dealer',
            {
                method:'POST',

                headers:{
                    'Content-Type':
                        'application/json'
                },

                body: JSON.stringify({
                    userId,
                    password
                })
            }
        );

        const data =
            await response.json();

        if(data.success){

            showToast(
                'Dealer created successfully',
                'success'
            );

            dealerForm.reset();

            // Hide form
            document.getElementById(
                'createDealerForm'
            ).style.display = 'none';

            // Reload dealers
            loadDealers();

        }else{

            showToast(
                data.message ||
                'Failed to create dealer',
                'error'
            );

        }

    }catch(error){

        console.log(error);

        showToast(
            'Server error occurred',
            'error'
        );

    }finally{

        submitBtn.disabled = false;

        submitBtn.innerText =
            'Create Dealer';

    }

});




// LOAD DEALERS

function loadDealers(){

    fetch('/admin/dealers')

    .then(response => response.json())

    .then(data => {

        const dealerList =
            document
            .getElementById('dealerList')
            .getElementsByTagName('tbody')[0];

        dealerList.innerHTML = '';

        data.dealers.forEach(dealer => {

            const row =
                dealerList.insertRow();

            row.innerHTML = `

                <td>
                    <span class="badge">
                        ${dealer.userId}
                    </span>
                </td>

                <td>
                    ${dealer.password}
                </td>

                <td>

                    <button
                        class="btn delete-btn"
                        onclick="deleteDealer('${dealer.id}')"
                    >
                        Delete
                    </button>

                </td>

            `;

        });

    })

    .catch(error =>
        console.error(
            'Error fetching dealers:',
            error
        )
    );

}




// DELETE DEALER

async function deleteDealer(dealerId){

    const confirmDelete =
        confirm(
            "Are you sure you want to delete this dealer?"
        );

    if(!confirmDelete){
        return;
    }

    try{

        const response = await fetch(
            `/admin/delete-dealer/${dealerId}`,
            {
                method:'DELETE',
            }
        );

        const data =
            await response.json();

        if(data.success){

            showToast(
                'Dealer deleted successfully',
                'success'
            );

            loadDealers();

        }else{

            showToast(
                data.message ||
                'Failed to delete dealer',
                'error'
            );

        }

    }catch(error){

        console.log(error);

        showToast(
            'Error deleting dealer',
            'error'
        );

    }

}




// TOAST UI

function showToast(message,type='success'){

    const toast =
        document.createElement('div');

    toast.innerText = message;

    toast.style.position = 'fixed';

    toast.style.top = '25px';

    toast.style.right = '25px';

    toast.style.padding = '14px 22px';

    toast.style.borderRadius = '16px';

    toast.style.fontWeight = '600';

    toast.style.fontSize = '14px';

    toast.style.zIndex = '9999';

    toast.style.color = 'white';

    toast.style.boxShadow =
        '0 10px 25px rgba(0,0,0,0.15)';

    toast.style.transform =
        'translateY(-20px)';

    toast.style.opacity = '0';

    toast.style.transition = '.3s';

    if(type === 'success'){

        toast.style.background =
            'linear-gradient(135deg,#22c55e,#16a34a)';

    }else{

        toast.style.background =
            'linear-gradient(135deg,#ef4444,#dc2626)';

    }

    document.body.appendChild(toast);

    setTimeout(()=>{

        toast.style.transform =
            'translateY(0)';

        toast.style.opacity = '1';

    },50);

    setTimeout(()=>{

        toast.style.transform =
            'translateY(-20px)';

        toast.style.opacity = '0';

        setTimeout(()=>{

            toast.remove();

        },300);

    },2500);

}




// INITIAL LOAD

window.onload = loadDealers;

</script>

</body>

</html>