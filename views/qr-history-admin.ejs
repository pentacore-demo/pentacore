<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>QR Apply History</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>

/* ===== BASE ===== */
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:'Inter',sans-serif;
    background:#f6f8fb;
    color:#1e293b;
    min-height:100vh;
    overflow-x:hidden;
}

/* ===== BACKGROUND ===== */
.bg{
    position:fixed;
    border-radius:50%;
    filter:blur(90px);
    opacity:.45;
    z-index:0;
    pointer-events:none;
}

.bg1{
    width:320px;
    height:320px;
    background:#c7d2fe;
    top:-100px;
    left:-100px;
}

.bg2{
    width:320px;
    height:320px;
    background:#fde68a;
    bottom:-100px;
    right:-100px;
}

/* ===== CONTAINER ===== */
.container{
    position:relative;
    z-index:2;
    max-width:1400px;
    margin:auto;
    padding:30px 20px;
}

/* ===== HEADER ===== */
.top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
    margin-bottom:25px;
    flex-wrap:wrap;
}

.title h1{
    font-size:34px;
    color:#0f172a;
    margin-bottom:8px;
}

.title p{
    color:#64748b;
    font-size:14px;
}

/* ===== SEARCH ===== */
.search-area{
    display:flex;
    gap:12px;
    flex-wrap:wrap;
}

.search-area input{
    height:54px;
    border-radius:18px;
    border:1px solid #e2e8f0;
    background:rgba(255,255,255,0.85);
    padding:0 18px;
    font-size:14px;
    outline:none;
    min-width:240px;
    backdrop-filter:blur(12px);
}

.search-area input:focus{
    border-color:#a5b4fc;
    box-shadow:0 0 0 4px rgba(99,102,241,.08);
}

.search-area button{
    height:54px;
    padding:0 22px;
    border:none;
    border-radius:18px;
    background:linear-gradient(135deg,#818cf8,#6366f1);
    color:white;
    font-weight:600;
    cursor:pointer;
    transition:.25s;
}

.search-area button:hover{
    transform:translateY(-2px);
}

/* ===== FILTERS ===== */
.filters{
    display:flex;
    gap:15px;
    flex-wrap:wrap;
    margin-bottom:25px;
}

.filter-box{
    background:rgba(255,255,255,0.82);
    backdrop-filter:blur(18px);
    border:1px solid rgba(255,255,255,0.7);
    border-radius:20px;
    padding:14px 18px;
}

.filter-box label{
    display:block;
    font-size:13px;
    color:#64748b;
    margin-bottom:8px;
}

.filter-box input{
    border:none;
    outline:none;
    font-size:14px;
    background:transparent;
}

/* ===== SUMMARY ===== */
.summary{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
    gap:20px;
    margin-bottom:25px;
}

.summary-card{
    background:rgba(255,255,255,0.82);
    backdrop-filter:blur(18px);
    border:1px solid rgba(255,255,255,0.7);
    border-radius:28px;
    padding:28px;
    box-shadow:
        0 20px 40px rgba(15,23,42,0.06),
        0 2px 10px rgba(15,23,42,0.04);
}

.summary-card h3{
    color:#64748b;
    font-size:14px;
    margin-bottom:10px;
}

.summary-card p{
    font-size:34px;
    font-weight:700;
    color:#0f172a;
}

/* ===== TABLE ===== */
.table-wrapper{
    background:rgba(255,255,255,0.82);
    backdrop-filter:blur(20px);
    border-radius:28px;
    overflow:hidden;
    border:1px solid rgba(255,255,255,0.7);
    box-shadow:
        0 20px 40px rgba(15,23,42,0.06),
        0 2px 10px rgba(15,23,42,0.04);
}

.table-scroll{
    overflow-x:auto;
}

table{
    width:100%;
    border-collapse:collapse;
    min-width:700px;
}

thead{
    background:#eef2ff;
}

th{
    text-align:left;
    padding:18px;
    font-size:13px;
    color:#4f46e5;
}

td{
    padding:18px;
    border-top:1px solid #f1f5f9;
    font-size:14px;
    color:#334155;
}

tr:hover{
    background:#f8fafc;
}

/* ===== BADGE ===== */
.badge{
    display:inline-block;
    padding:8px 14px;
    border-radius:999px;
    background:#eef2ff;
    color:#4f46e5;
    font-size:12px;
    font-weight:600;
}

/* ===== PAGINATION ===== */
.pagination{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:10px;
    flex-wrap:wrap;
    margin-top:30px;
}

.pagination a{
    min-width:42px;
    height:42px;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:0 14px;
    border-radius:14px;
    background:white;
    border:1px solid #e2e8f0;
    text-decoration:none;
    color:#334155;
    font-size:14px;
    transition:.2s;
    font-weight:600;
}

.pagination a:hover{
    background:#eef2ff;
    color:#4f46e5;
}

.active-page{
    background:#6366f1 !important;
    color:white !important;
    border-color:#6366f1 !important;
}

/* ===== MOBILE ===== */
@media(max-width:700px){

    .container{
        padding:20px 14px;
    }

    .title h1{
        font-size:28px;
    }

    .search-area{
        width:100%;
    }

    .search-area input{
        width:100%;
    }

    .search-area button{
        width:100%;
    }

    .filters{
        flex-direction:column;
    }

    .summary-card{
        border-radius:24px;
        padding:22px;
    }

}

</style>

</head>

<body>

<div class="bg bg1"></div>
<div class="bg bg2"></div>

<div class="container">

    <!-- HEADER -->
    <div class="top">

        <div class="title">
            <h1>QR Apply History</h1>
            <p>
                View scanned QR codes and earned points
            </p>
        </div>

        <div class="search-area">

            <input
                type="text"
                id="search-bar"
                placeholder="Search QR Code..."
                value="<%= search || '' %>"
            >

            <button id="search-btn">
                Search
            </button>

        </div>

    </div>

    <!-- FILTER -->
    <div class="filters">

        <div class="filter-box">
            <label>Start Date</label>
            <input
                type="date"
                id="start-date"
                value="<%= startDate || '' %>"
            >
        </div>

        <div class="filter-box">
            <label>End Date</label>
            <input
                type="date"
                id="end-date"
                value="<%= endDate || '' %>"
            >
        </div>

    </div>

    <!-- SUMMARY -->
    <div class="summary">

        <div class="summary-card">
            <h3>Total Points</h3>
            <p><%= totalPoints %></p>
        </div>

        <div class="summary-card">
            <h3>Total QR Scanned</h3>
            <p><%= totalScanned %></p>
        </div>

    </div>

    <!-- TABLE -->
    <div class="table-wrapper">

        <div class="table-scroll">

            <table>

                <thead>

                    <tr>
                        <th>Date</th>
                        <th>Batch</th>
                        <th>QR Code</th>
                        <th>Points</th>
                    </tr>

                </thead>

                <tbody id="coupon-table-body">

                    <% coupons.forEach(function(coupon){ %>

                    <tr>

                        <td><%= coupon.dateScanned %></td>

                        <td>
                            <span class="badge">
                                <%= coupon.qrBatch %>
                            </span>
                        </td>

                        <td><%= coupon.qrCode %></td>

                        <td><%= coupon.points %></td>

                    </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    </div>

    <!-- PAGINATION -->
    <div class="pagination">

        <% if(currentPage > 1){ %>

            <a href="?page=<%= currentPage - 1 %>&search=<%= search || '' %>&startDate=<%= startDate || '' %>&endDate=<%= endDate || '' %>">
                Prev
            </a>

        <% } %>

        <% for(let i = 1; i <= totalPages; i++){ %>

            <a
                href="?page=<%= i %>&search=<%= search || '' %>&startDate=<%= startDate || '' %>&endDate=<%= endDate || '' %>"
                class="<%= currentPage === i ? 'active-page' : '' %>"
            >
                <%= i %>
            </a>

        <% } %>

        <% if(currentPage < totalPages){ %>

            <a href="?page=<%= currentPage + 1 %>&search=<%= search || '' %>&startDate=<%= startDate || '' %>&endDate=<%= endDate || '' %>">
                Next
            </a>

        <% } %>

    </div>

</div>

<script>

const searchBar =
    document.getElementById("search-bar");

const searchBtn =
    document.getElementById("search-btn");

const startDateInput =
    document.getElementById("start-date");

const endDateInput =
    document.getElementById("end-date");

// APPLY FILTERS
function applyFilters(){

    const search =
        searchBar.value.trim();

    const startDate =
        startDateInput.value;

    const endDate =
        endDateInput.value;

    const url =
        `?page=1&search=${encodeURIComponent(search)}&startDate=${encodeURIComponent(startDate)}&endDate=${encodeURIComponent(endDate)}`;

    window.location.href = url;

}

// EVENTS
searchBtn.addEventListener(
    "click",
    applyFilters
);

searchBar.addEventListener(
    "keypress",
    function(e){
        if(e.key === "Enter"){
            applyFilters();
        }
    }
);

startDateInput.addEventListener(
    "change",
    applyFilters
);

endDateInput.addEventListener(
    "change",
    applyFilters
);

</script>

</body>
</html>