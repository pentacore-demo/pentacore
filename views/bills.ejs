<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Billing Dashboard</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>

/* RESET */
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:'Inter',sans-serif;
    background:#f6f8fb;
    color:#0f172a;
    min-height:100vh;
    overflow-x:hidden;
}

/* BACKGROUND */
.bg{
    position:fixed;
    border-radius:50%;
    filter:blur(90px);
    opacity:.45;
    z-index:0;
}

.bg1{
    width:350px;
    height:350px;
    background:#c7d2fe;
    top:-120px;
    left:-120px;
}

.bg2{
    width:350px;
    height:350px;
    background:#fde68a;
    bottom:-120px;
    right:-120px;
}

/* CONTAINER */
.container{
    position:relative;
    z-index:2;
    max-width:1500px;
    margin:auto;
    padding:30px 20px;
}

/* HEADER */
.header{
    margin-bottom:25px;
}

.header h1{
    font-size:34px;
    margin-bottom:6px;
}

.header p{
    color:#64748b;
    font-size:14px;
}

/* GRID */
.grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
    gap:20px;
}

/* CARD */
.card{
    background:rgba(255,255,255,0.85);
    backdrop-filter:blur(18px);
    border:1px solid rgba(255,255,255,0.7);
    border-radius:26px;
    padding:22px;
    box-shadow:0 20px 40px rgba(15,23,42,0.06);
    transition:.25s;
}

.card:hover{
    transform:translateY(-4px);
}

/* MONTH */
.month{
    font-size:20px;
    font-weight:700;
    margin-bottom:14px;
}

/* INFO */
.info{
    font-size:14px;
    color:#475569;
    margin:6px 0;
}

/* BADGE */
.badge{
    display:inline-block;
    padding:6px 12px;
    border-radius:999px;
    font-size:12px;
    font-weight:600;
}

/* STATUS */
.unpaid{
    background:#fff7ed;
    color:#c2410c;
}

.paid{
    background:#dcfce7;
    color:#166534;
}

.processing{
    background:#e0f2fe;
    color:#0369a1;
}

/* BUTTON */
.btn{
    width:100%;
    margin-top:14px;
    padding:12px 16px;
    border-radius:14px;
    border:none;
    cursor:pointer;
    font-weight:600;
    text-align:center;
    transition:.25s;

    display:flex;
    align-items:center;
    justify-content:center;

    text-decoration:none;
    font-size:14px;
}

/* VIEW */
.view{
    background:#f1f5f9;
    color:#0f172a;
}

/* WITHDRAW */
.withdraw{
    background:linear-gradient(135deg,#6366f1,#818cf8);
    color:white;
}

.withdraw:hover{
    transform:translateY(-2px);
}

/* DISABLED */
.disabled{
    opacity:0.6;
    pointer-events:none;
}

/* MODAL */
.modal{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,0.5);
    display:none;
    justify-content:center;
    align-items:center;
    z-index:999;
}

.modal-box{
    width:90%;
    max-width:380px;
    background:white;
    padding:25px;
    border-radius:18px;
}

.modal-box h3{
    margin-bottom:12px;
}

.modal-box input{
    width:100%;
    padding:12px;
    border-radius:12px;
    border:1px solid #e2e8f0;
    margin-bottom:12px;
}

.cancel{
    width:100%;
    margin-top:10px;
    background:#f1f5f9;
    border:none;
    padding:10px;
    border-radius:12px;
    cursor:pointer;
}

/* TOAST */
.toast{
    position:fixed;
    bottom:20px;
    right:20px;
    background:#16a34a;
    color:white;
    padding:12px 18px;
    border-radius:12px;
    font-size:14px;
    display:none;
    z-index:1000;
}

</style>

</head>

<body>

<div class="bg bg1"></div>
<div class="bg bg2"></div>

<div class="container">

<div class="header">
    <h1>Billing Dashboard</h1>
    <p>Monthly QR scan</p>
</div>

<div class="grid">

<% for(let month in monthlyData){ %>

<%
    const status = monthlyData[month].status;
    const canWithdraw = status !== "PAID" && status !== "PROCESSING";
%>

<div class="card" id="card-<%= month %>">

    <div class="month"><%= month %></div>

    <div class="info">
        Total Scans: <b><%= monthlyData[month].totalScans %></b>
    </div>

    <div class="info">
        Amount: <b>₹<%= monthlyData[month].amount %></b>
    </div>

    <div class="info">
        Status:
        <span class="badge <%= status === 'PAID' ? 'paid' : status === 'PROCESSING' ? 'processing' : 'unpaid' %>"
              id="status-<%= month %>">
            <%= status %>
        </span>
    </div>

    <a href="/admin/bills/<%= month %>" class="btn view">
        View Details
    </a>

    <% if(canWithdraw){ %>

    <button class="btn withdraw" id="btn-<%= month %>" onclick="openModal('<%= month %>')">
        Withdraw
    </button>

    <% } else { %>

    <button class="btn withdraw disabled">
        <%= status === "PROCESSING" ? "Processing..." : "Paid" %>
    </button>

    <% } %>

</div>

<% } %>

</div>

</div>

<!-- MODAL -->
<div class="modal" id="modal">

<div class="modal-box">

    <h3>Confirm Withdraw</h3>

    <input type="password" id="password" placeholder="Enter password">

    <button class="btn withdraw" onclick="confirmWithdraw()">
        Confirm
    </button>

    <button class="cancel" onclick="closeModal()">
        Cancel
    </button>

</div>

</div>

<!-- TOAST -->
<div class="toast" id="toast">
    Withdraw Started
</div>

<script>

let selectedMonth = "";
let loading = false;

function openModal(month){
    selectedMonth = month;
    document.getElementById("modal").style.display = "flex";
}

function closeModal(){
    document.getElementById("modal").style.display = "none";
    document.getElementById("password").value = "";
}

window.onclick = function(e){
    if(e.target.id === "modal"){
        closeModal();
    }
}

function showToast(){
    const t = document.getElementById("toast");
    t.style.display = "block";
    setTimeout(()=>t.style.display="none",2000);
}

async function confirmWithdraw(){

    if(loading) return;

    const password = document.getElementById("password").value;

    if(!password){
        return;
    }

    // 🔥 GET AMOUNT FOR CONFIRMATION
    const card = document.getElementById("card-" + selectedMonth);
    const amount = card.querySelectorAll(".info b")[1].innerText;

    const confirmMsg = `Confirm Withdraw:\n\nMonth: ${selectedMonth}\nAmount: ${amount}\n\nProceed?`;

    if(!confirm(confirmMsg)){
        return;
    }

    loading = true;

    try{

        const res = await fetch("/admin/withdraw/" + selectedMonth, {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({ password })
        });

        const data = await res.json();

        if(!data.success){
            loading = false;
            alert(data.message || "Withdraw failed");
            return;
        }

        // UPDATE UI ONLY AFTER SUCCESS
        document.getElementById("status-" + selectedMonth).innerText = "PROCESSING";
        document.getElementById("status-" + selectedMonth).className = "badge processing";

        const btn = document.getElementById("btn-" + selectedMonth);
        if(btn) btn.remove();

        closeModal();
        showToast();

    }catch(err){
        alert("Server error");
    }

    loading = false;
}

</script>

</body>
</html>