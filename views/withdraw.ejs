<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Withdraw Funds</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:'Inter',sans-serif;
    background:#f6f8fb;
    color:#1e293b;
    min-height:100vh;
    overflow-x:hidden;
}

/* BACKGROUND */

.bg{
    position:fixed;
    border-radius:50%;
    filter:blur(90px);
    opacity:.45;
    z-index:0;
    pointer-events:none;
}

.bg1{
    width:320px;
    height:320px;
    background:#c7d2fe;
    top:-100px;
    left:-100px;
}

.bg2{
    width:320px;
    height:320px;
    background:#fde68a;
    bottom:-100px;
    right:-100px;
}

/* CONTAINER */

.container{
    position:relative;
    z-index:2;
    max-width:600px;
    margin:auto;
    padding:30px 20px;
}

/* HEADER */

.top{
    margin-bottom:25px;
    text-align:center;
}

.top h1{
    font-size:34px;
    color:#0f172a;
    margin-bottom:10px;
}

.top p{
    color:#64748b;
    font-size:15px;
}

/* CARD */

.withdraw-card{
    background:rgba(255,255,255,0.82);
    backdrop-filter:blur(20px);
    border-radius:32px;
    padding:35px;
    border:1px solid rgba(255,255,255,0.7);
    box-shadow:
        0 20px 40px rgba(15,23,42,0.06),
        0 2px 10px rgba(15,23,42,0.04);
}

/* BALANCE */

.balance-box{
    background:#eef2ff;
    border-radius:24px;
    padding:24px;
    margin-bottom:28px;
    text-align:center;
}

.balance-box h3{
    color:#64748b;
    font-size:15px;
    margin-bottom:10px;
}

.balance-box h2{
    font-size:42px;
    color:#4f46e5;
    font-weight:700;
}

/* MESSAGE */

.message{
    padding:16px 18px;
    border-radius:18px;
    margin-bottom:24px;
    font-size:14px;
    font-weight:500;
}

.success{
    background:#dcfce7;
    color:#166534;
}

.error{
    background:#fee2e2;
    color:#991b1b;
}

/* FORM */

.form-group{
    margin-bottom:22px;
}

.form-group label{
    display:block;
    margin-bottom:10px;
    color:#475569;
    font-size:14px;
    font-weight:600;
}

.form-group input{
    width:100%;
    height:58px;
    border-radius:18px;
    border:1px solid #e2e8f0;
    background:rgba(255,255,255,0.9);
    padding:0 18px;
    font-size:15px;
    outline:none;
    transition:.25s;
}

.form-group input:focus{
    border-color:#6366f1;
    box-shadow:0 0 0 4px rgba(99,102,241,0.1);
}

.form-group input[readonly]{
    background:#f8fafc;
    color:#64748b;
}

/* BUTTON */

.submit-btn{
    width:100%;
    height:58px;
    border:none;
    border-radius:20px;
    background:linear-gradient(135deg,#818cf8,#6366f1);
    color:white;
    font-size:16px;
    font-weight:700;
    cursor:pointer;
    transition:.25s;
}

.submit-btn:hover{
    transform:translateY(-2px);
    box-shadow:0 10px 25px rgba(99,102,241,0.25);
}

/* NOTE */

.note{
    margin-top:18px;
    font-size:13px;
    color:#64748b;
    text-align:center;
}

/* MOBILE */

@media(max-width:700px){

    .container{
        padding:20px 14px;
    }

    .top h1{
        font-size:28px;
    }

    .withdraw-card{
        padding:24px;
        border-radius:24px;
    }

    .balance-box{
        border-radius:20px;
        padding:20px;
    }

    .balance-box h2{
        font-size:34px;
    }

}

</style>

</head>

<body>

<div class="bg bg1"></div>
<div class="bg bg2"></div>

<div class="container">

    <!-- HEADER -->

    <div class="top">

        <h1>Withdraw Funds</h1>

        <p>
            Transfer your wallet balance directly to your bank
        </p>

    </div>

    <!-- CARD -->

    <div class="withdraw-card">

        <!-- BALANCE -->

        <div class="balance-box">

            <h3>Available Wallet Balance</h3>

            <h2>
                ₹<%= walletBalance %>
            </h2>

        </div>

        <!-- MESSAGE -->

        <% if (message) { %>

            <div class="message <%= message.includes('successful') ? 'success' : 'error' %>">

                <%= message %>

            </div>

        <% } %>

        <!-- FORM -->

        <form action="/user/withdraw" method="POST">

            <div class="form-group">

                <label>
                    Beneficiary ID
                </label>

                <input
                    type="text"
                    id="beneficiary_id"
                    value="<%= beneficiary_id %>"
                    readonly
                >

            </div>

            <div class="form-group">

                <label>
                    Withdrawal Amount
                </label>

                <input
                    type="number"
                    id="withdrawAmount"
                    name="withdrawAmount"
                    placeholder="Minimum withdrawal amount is ₹50"
                    required
                >

            </div>

            <button type="submit" class="submit-btn">

                Withdraw Now

            </button>

        </form>

        <div class="note">

            Minimum withdrawal amount is ₹50

        </div>

    </div>

</div>

</body>

</html>