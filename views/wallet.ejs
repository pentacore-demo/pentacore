<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Wallet Balances</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:'Inter',sans-serif;
    background:#f6f8fb;
    color:#1e293b;
    min-height:100vh;
    overflow-x:hidden;
}

/* BACKGROUND */

.bg{
    position:fixed;
    border-radius:50%;
    filter:blur(90px);
    opacity:.45;
    z-index:0;
    pointer-events:none;
}

.bg1{
    width:320px;
    height:320px;
    background:#c7d2fe;
    top:-100px;
    left:-100px;
}

.bg2{
    width:320px;
    height:320px;
    background:#fde68a;
    bottom:-100px;
    right:-100px;
}

/* CONTAINER */

.container{
    position:relative;
    z-index:2;
    max-width:1400px;
    margin:auto;
    padding:30px 20px;
}

/* HEADER */

.top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
    margin-bottom:25px;
    flex-wrap:wrap;
}

.title h1{
    font-size:34px;
    color:#0f172a;
    margin-bottom:8px;
}

.title p{
    color:#64748b;
    font-size:14px;
}

/* FILTERS */

.filters{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:16px;
    margin-bottom:25px;
}

.filter-box{
    background:rgba(255,255,255,0.82);
    backdrop-filter:blur(18px);
    border:1px solid rgba(255,255,255,0.7);
    border-radius:20px;
    padding:14px 18px;
}

.filter-box label{
    display:block;
    font-size:13px;
    color:#64748b;
    margin-bottom:8px;
}

.filter-box input{
    border:none;
    outline:none;
    width:100%;
    background:transparent;
    font-size:14px;
}

/* BUTTON */

.action-area{
    margin-bottom:25px;
}

.action-area button{
    height:54px;
    padding:0 24px;
    border:none;
    border-radius:18px;
    background:linear-gradient(135deg,#818cf8,#6366f1);
    color:white;
    font-weight:600;
    cursor:pointer;
    transition:.25s;
}

.action-area button:hover{
    transform:translateY(-2px);
}

/* TABLE */

.table-wrapper{
    background:rgba(255,255,255,0.82);
    backdrop-filter:blur(20px);
    border-radius:28px;
    overflow:hidden;
    border:1px solid rgba(255,255,255,0.7);
    box-shadow:
        0 20px 40px rgba(15,23,42,0.06),
        0 2px 10px rgba(15,23,42,0.04);
}

.table-scroll{
    overflow-x:auto;
}

table{
    width:100%;
    border-collapse:collapse;
    min-width:700px;
}

thead{
    background:#eef2ff;
}

th{
    text-align:left;
    padding:18px;
    font-size:13px;
    color:#4f46e5;
}

td{
    padding:18px;
    border-top:1px solid #f1f5f9;
    font-size:14px;
    color:#334155;
}

tr:hover{
    background:#f8fafc;
}

/* BALANCE BADGE */

.balance{
    display:inline-block;
    padding:8px 14px;
    border-radius:999px;
    background:#eef2ff;
    color:#4f46e5;
    font-size:12px;
    font-weight:600;
}

/* MOBILE */

@media(max-width:700px){

    body{
        overflow-x:hidden;
    }

    .container{
        padding:18px 12px;
    }

    .top{
        flex-direction:column;
        align-items:flex-start;
    }

    .title h1{
        font-size:26px;
    }

    .filters{
        grid-template-columns:1fr;
    }

    .filter-box{
        border-radius:18px;
    }

    .action-area button{
        width:100%;
    }

    .table-wrapper{
        border-radius:22px;
    }

    table{
        min-width:600px;
    }

    th,
    td{
        white-space:nowrap;
        padding:14px;
        font-size:13px;
    }

    .bg1,
    .bg2{
        width:220px;
        height:220px;
    }

}

</style>

</head>

<body>

<div class="bg bg1"></div>
<div class="bg bg2"></div>

<div class="container">

    <!-- HEADER -->

    <div class="top">

        <div class="title">
            <h1>Wallet Balances</h1>
            <p>
                View all user wallet balances
            </p>
        </div>

    </div>

    <!-- FILTERS -->

    <div class="filters">

        <div class="filter-box">
            <label>Search User</label>
            <input
                type="text"
                id="searchBar"
                placeholder="Name or Mobile Number"
                onkeyup="filterTable()"
            >
        </div>

        <div class="filter-box">
            <label>Minimum Balance</label>
            <input
                type="number"
                id="minBalance"
                placeholder="Enter Minimum Balance"
                onkeyup="filterTable()"
            >
        </div>

        <div class="filter-box">
            <label>Maximum Balance</label>
            <input
                type="number"
                id="maxBalance"
                placeholder="Enter Maximum Balance"
                onkeyup="filterTable()"
            >
        </div>

    </div>

    <!-- BUTTON -->

    <div class="action-area">

        <button onclick="filterTable()">
            Apply Filters
        </button>

    </div>

    <!-- TABLE -->

    <div class="table-wrapper">

        <div class="table-scroll">

            <table id="walletTable">

                <thead>

                    <tr>
                        <th>Name</th>
                        <th>Mobile Number</th>
                        <th>Wallet Balance</th>
                    </tr>

                </thead>

                <tbody>

                    <% users.forEach(user => { %>

                        <tr>

                            <td>
                                <%= user.fullName %>
                            </td>

                            <td>
                                <%= user.mobileNumber %>
                            </td>

                            <td>

                                <span class="balance">

                                    ₹<%= isNaN(parseFloat(user.walletBalance))
                                        ? '0.00'
                                        : parseFloat(user.walletBalance).toFixed(2)
                                    %>

                                </span>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    </div>

</div>

<script>

function filterTable(){

    const searchQuery =
        document.getElementById("searchBar")
        .value
        .toLowerCase();

    const minBalance =
        parseFloat(
            document.getElementById("minBalance").value
        ) || 0;

    const maxBalance =
        parseFloat(
            document.getElementById("maxBalance").value
        ) || Infinity;

    const rows =
        document.querySelectorAll(
            "#walletTable tbody tr"
        );

    rows.forEach(row => {

        const name =
            row.cells[0]
            .textContent
            .toLowerCase();

        const mobile =
            row.cells[1]
            .textContent;

        const balance =
            parseFloat(
                row.cells[2]
                .textContent
                .replace('₹','')
            );

        const matchesSearch =
            name.includes(searchQuery) ||
            mobile.includes(searchQuery);

        const matchesBalance =
            balance >= minBalance &&
            balance <= maxBalance;

        if(matchesSearch && matchesBalance){

            row.style.display = '';

        }else{

            row.style.display = 'none';

        }

    });

}

</script>

</body>

</html>