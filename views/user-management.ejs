<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>User Management</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<style>

/* ===== BASE ===== */
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:'Inter',sans-serif;
    background:#f6f8fb;
    color:#1e293b;
    min-height:100vh;
    overflow-x:hidden;
}

/* ===== BG ===== */
.bg{
    position:fixed;
    border-radius:50%;
    filter:blur(90px);
    opacity:.45;
    z-index:0;
    pointer-events:none;
}

.bg1{
    width:320px;
    height:320px;
    background:#c7d2fe;
    top:-100px;
    left:-100px;
}

.bg2{
    width:340px;
    height:340px;
    background:#fde68a;
    bottom:-100px;
    right:-100px;
}

/* ===== CONTAINER ===== */
.container{
    position:relative;
    z-index:2;
    max-width:1500px;
    margin:auto;
    padding:30px 20px;
}

/* ===== HEADER ===== */
.top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
    margin-bottom:30px;
    flex-wrap:wrap;
}

.title h1{
    font-size:34px;
    color:#0f172a;
    margin-bottom:8px;
}

.title p{
    color:#64748b;
    font-size:14px;
}

/* ===== SEARCH ===== */
.search-container{
    display:flex;
    gap:12px;
    flex-wrap:wrap;
}

.search-container input{
    width:320px;
    max-width:100%;
    height:54px;
    border-radius:18px;
    border:1px solid #e2e8f0;
    background:rgba(255,255,255,0.85);
    padding:0 18px;
    font-size:14px;
    outline:none;
    transition:.25s;
    backdrop-filter:blur(12px);
}

.search-container input:focus{
    border-color:#a5b4fc;
    box-shadow:0 0 0 4px rgba(99,102,241,.08);
}

.search-container button{
    height:54px;
    width:54px;
    border:none;
    border-radius:18px;
    background:linear-gradient(135deg,#818cf8,#6366f1);
    color:white;
    cursor:pointer;
    font-size:16px;
    transition:.25s;
    box-shadow:0 10px 20px rgba(99,102,241,.15);
}

.search-container button:hover{
    transform:translateY(-2px);
}

/* ===== TABLE WRAPPER ===== */
.table-wrapper{
    background:rgba(255,255,255,0.82);
    backdrop-filter:blur(20px);
    border-radius:28px;
    overflow:hidden;
    border:1px solid rgba(255,255,255,0.7);
    box-shadow:
        0 20px 40px rgba(15,23,42,0.06),
        0 2px 10px rgba(15,23,42,0.04);
}

/* ===== TABLE ===== */
.table-container{
    overflow:auto;
}

table{
    width:100%;
    border-collapse:collapse;
    min-width:1000px;
}

thead{
    background:#eef2ff;
}

thead th{
    padding:20px;
    text-align:left;
    color:#4f46e5;
    font-size:14px;
    font-weight:600;
}

tbody tr{
    border-top:1px solid #e2e8f0;
    transition:.2s;
}

tbody tr:hover{
    background:#f8fafc;
}

tbody td{
    padding:18px 20px;
    font-size:14px;
    color:#334155;
}

/* ===== STATUS ===== */
.status{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:8px 14px;
    border-radius:999px;
    font-size:12px;
    font-weight:600;
}

.active{
    background:#dcfce7;
    color:#15803d;
}

.inactive{
    background:#fee2e2;
    color:#dc2626;
}

/* ===== USER TYPE ===== */
.type{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:8px 14px;
    border-radius:999px;
    background:#eef2ff;
    color:#4f46e5;
    font-size:12px;
    font-weight:600;
}

/* ===== ACTIONS ===== */
.actions{
    display:flex;
    gap:10px;
}

.action-btn{
    width:42px;
    height:42px;
    border-radius:14px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-decoration:none;
    transition:.25s;
}

.action-btn i{
    font-size:15px;
}

.edit-btn{
    background:#fef3c7;
    color:#b45309;
}

.history-btn{
    background:#dcfce7;
    color:#15803d;
}

.action-btn:hover{
    transform:translateY(-2px);
}

/* ===== MOBILE CARDS ===== */
.mobile-users{
    display:none;
    gap:16px;
    flex-direction:column;
}

.user-card{
    background:rgba(255,255,255,0.85);
    backdrop-filter:blur(18px);
    border-radius:24px;
    padding:20px;
    border:1px solid rgba(255,255,255,0.7);
    box-shadow:
        0 20px 40px rgba(15,23,42,0.06),
        0 2px 10px rgba(15,23,42,0.04);
}

.user-top{
    margin-bottom:16px;
}

.user-top h3{
    font-size:18px;
    margin-bottom:6px;
    color:#0f172a;
}

.user-top p{
    color:#64748b;
    font-size:14px;
}

.user-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
    margin-bottom:18px;
}

.info-box{
    background:#ffffffcc;
    border:1px solid #e2e8f0;
    border-radius:16px;
    padding:14px;
}

.info-box small{
    display:block;
    font-size:12px;
    color:#64748b;
    margin-bottom:6px;
}

.info-box span{
    font-size:14px;
    font-weight:600;
    color:#0f172a;
    word-break:break-word;
}

.mobile-actions{
    display:flex;
    gap:12px;
}

/* ===== MOBILE ===== */
@media(max-width:900px){

    .table-wrapper{
        display:none;
    }

    .mobile-users{
        display:flex;
    }

}

@media(max-width:600px){

    .container{
        padding:20px 14px;
    }

    .top{
        align-items:flex-start;
    }

    .title h1{
        font-size:28px;
    }

    .search-container{
        width:100%;
    }

    .search-container input{
        width:100%;
    }

    .user-grid{
        grid-template-columns:1fr;
    }

}

</style>

</head>

<body>

<div class="bg bg1"></div>
<div class="bg bg2"></div>

<div class="container">

    <!-- HEADER -->
    <div class="top">

        <div class="title">

            <h1>User Management</h1>

            <p>
                Manage users, history and profile information
            </p>

        </div>

        <div class="search-container">

            <input
                type="text"
                id="search-input"
                placeholder="Search by Mobile Number"
            >

            <button id="search-btn">
                <i class="fa fa-search"></i>
            </button>

        </div>

    </div>

    <!-- DESKTOP TABLE -->
    <div class="table-wrapper">

        <div class="table-container">

            <table>

                <thead>

                    <tr>

                        <th>#</th>
                        <th>Name</th>
                        <th>Mobile</th>
                        <th>User Type</th>
                        <th>Status</th>
                        <th>State</th>
                        <th>City</th>
                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody id="user-table-body">

                    <% users.forEach((user, index) => { %>

                    <tr>

                        <td><%= index + 1 %></td>

                        <td>
                            <strong>
                                <%= user.fullName %>
                            </strong>
                        </td>

                        <td>
                            <%= user.mobileNumber %>
                        </td>

                        <td>

                            <span class="type">
                                <%= user.userType %>
                            </span>

                        </td>

                        <td>

                            <span class="status <%= user.status === 'Active' ? 'active' : 'inactive' %>">

                                <%= user.status %>

                            </span>

                        </td>

                        <td><%= user.state %></td>

                        <td><%= user.city %></td>

                        <td>

                            <div class="actions">

                                <a
                                    href="/admin/edit-user/<%= user.mobileNumber %>"
                                    class="action-btn edit-btn"
                                    title="Edit User"
                                >
                                    <i class="fa fa-pen"></i>
                                </a>

                                <a
                                    href="/admin/qr-history/<%= user.mobileNumber %>"
                                    class="action-btn history-btn"
                                    title="QR History"
                                >
                                    <i class="fa fa-clock"></i>
                                </a>

                            </div>

                        </td>

                    </tr>

                    <% }); %>

                </tbody>

            </table>

        </div>

    </div>

    <!-- MOBILE CARDS -->
    <div class="mobile-users" id="mobile-users">

        <% users.forEach((user, index) => { %>

        <div
            class="user-card"
            data-mobile="<%= user.mobileNumber %>"
        >

            <div class="user-top">

                <h3>
                    <%= user.fullName %>
                </h3>

                <p>
                    <%= user.mobileNumber %>
                </p>

            </div>

            <div class="user-grid">

                <div class="info-box">

                    <small>User Type</small>

                    <span>
                        <%= user.userType %>
                    </span>

                </div>

                <div class="info-box">

                    <small>Status</small>

                    <span>
                        <%= user.status %>
                    </span>

                </div>

                <div class="info-box">

                    <small>State</small>

                    <span>
                        <%= user.state %>
                    </span>

                </div>

                <div class="info-box">

                    <small>City</small>

                    <span>
                        <%= user.city %>
                    </span>

                </div>

            </div>

            <div class="mobile-actions">

                <a
                    href="/admin/edit-user/<%= user.mobileNumber %>"
                    class="action-btn edit-btn"
                >
                    <i class="fa fa-pen"></i>
                </a>

                <a
                    href="/admin/qr-history/<%= user.mobileNumber %>"
                    class="action-btn history-btn"
                >
                    <i class="fa fa-clock"></i>
                </a>

            </div>

        </div>

        <% }); %>

    </div>

</div>

<script>

/* SEARCH */
document
.getElementById('search-btn')
.addEventListener('click', filterTable);

document
.getElementById('search-input')
.addEventListener('input', filterTable);

function filterTable(){

    const query =
        document
        .getElementById('search-input')
        .value
        .trim()
        .toLowerCase();

    /* DESKTOP */
    const rows =
        document.querySelectorAll(
            '#user-table-body tr'
        );

    rows.forEach(row => {

        const mobileNumber =
            row.cells[2]
            .textContent
            .toLowerCase();

        const name =
            row.cells[1]
            .textContent
            .toLowerCase();

        if(
            mobileNumber.includes(query) ||
            name.includes(query)
        ){

            row.style.display = '';

        } else {

            row.style.display = 'none';

        }

    });

    /* MOBILE */
    const cards =
        document.querySelectorAll('.user-card');

    cards.forEach(card => {

        const mobile =
            card
            .getAttribute('data-mobile')
            .toLowerCase();

        const name =
            card
            .querySelector('h3')
            .textContent
            .toLowerCase();

        if(
            mobile.includes(query) ||
            name.includes(query)
        ){

            card.style.display = '';

        } else {

            card.style.display = 'none';

        }

    });

}

</script>

</body>
</html>