<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>QR Apply History</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:'Inter',sans-serif;
    background:#f6f8fb;
    color:#1e293b;
    min-height:100vh;
    overflow-x:hidden;
}

/* BACKGROUND */

.bg{
    position:fixed;
    border-radius:50%;
    filter:blur:90px;
    opacity:.45;
    z-index:0;
    pointer-events:none;
}

.bg1{
    width:320px;
    height:320px;
    background:#c7d2fe;
    top:-100px;
    left:-100px;
}

.bg2{
    width:320px;
    height:320px;
    background:#fde68a;
    bottom:-100px;
    right:-100px;
}

/* CONTAINER */

.container{
    position:relative;
    z-index:2;
    max-width:1400px;
    margin:auto;
    padding:30px 20px;
}

/* HEADER */

.top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
    margin-bottom:25px;
    flex-wrap:wrap;
}

.title h1{
    font-size:34px;
    color:#0f172a;
    margin-bottom:8px;
}

.title p{
    color:#64748b;
    font-size:14px;
}

/* SEARCH */

.search-area{
    display:flex;
    gap:12px;
    flex-wrap:wrap;
}

.search-area input{
    height:54px;
    border-radius:18px;
    border:1px solid #e2e8f0;
    background:rgba(255,255,255,0.85);
    padding:0 18px;
    font-size:14px;
    outline:none;
    min-width:260px;
    backdrop-filter:blur(12px);
}

.search-area button{
    height:54px;
    padding:0 22px;
    border:none;
    border-radius:18px;
    background:linear-gradient(135deg,#818cf8,#6366f1);
    color:white;
    font-weight:600;
    cursor:pointer;
    transition:.25s;
}

.search-area button:hover{
    transform:translateY(-2px);
}

/* FILTERS */

.filters{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:16px;
    margin-bottom:25px;
}

.filter-box{
    background:rgba(255,255,255,0.82);
    backdrop-filter:blur(18px);
    border:1px solid rgba(255,255,255,0.7);
    border-radius:20px;
    padding:14px 18px;
}

.filter-box label{
    display:block;
    font-size:13px;
    color:#64748b;
    margin-bottom:8px;
}

.filter-box input{
    border:none;
    outline:none;
    width:100%;
    background:transparent;
    font-size:14px;
}

/* SUMMARY */

.summary{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
    gap:20px;
    margin-bottom:25px;
}

.summary-card{
    background:rgba(255,255,255,0.82);
    backdrop-filter:blur(18px);
    border:1px solid rgba(255,255,255,0.7);
    border-radius:28px;
    padding:28px;
    box-shadow:
        0 20px 40px rgba(15,23,42,0.06),
        0 2px 10px rgba(15,23,42,0.04);
}

.summary-card h3{
    color:#64748b;
    font-size:14px;
    margin-bottom:10px;
}

.summary-card p{
    font-size:34px;
    font-weight:700;
    color:#0f172a;
}

/* TABLE */

.table-wrapper{
    background:rgba(255,255,255,0.82);
    backdrop-filter:blur(20px);
    border-radius:28px;
    overflow:hidden;
    border:1px solid rgba(255,255,255,0.7);
    box-shadow:
        0 20px 40px rgba(15,23,42,0.06),
        0 2px 10px rgba(15,23,42,0.04);
}

.table-scroll{
    overflow-x:auto;
}

table{
    width:100%;
    border-collapse:collapse;
    min-width:800px;
}

thead{
    background:#eef2ff;
}

th{
    text-align:left;
    padding:18px;
    font-size:13px;
    color:#4f46e5;
}

td{
    padding:18px;
    border-top:1px solid #f1f5f9;
    font-size:14px;
    color:#334155;
}

tr:hover{
    background:#f8fafc;
}

/* BADGE */

.badge{
    display:inline-block;
    padding:8px 14px;
    border-radius:999px;
    background:#eef2ff;
    color:#4f46e5;
    font-size:12px;
    font-weight:600;
}

/* MOBILE */

@media(max-width:700px){

    .container{
        padding:20px 14px;
    }

    .title h1{
        font-size:28px;
    }

    .search-area{
        width:100%;
    }

    .search-area input{
        width:100%;
        min-width:100%;
    }

    .search-area button{
        width:100%;
    }

    .summary-card{
        padding:22px;
    }

    .summary-card p{
        font-size:28px;
    }

}

</style>

</head>

<body>

<div class="bg bg1"></div>
<div class="bg bg2"></div>

<div class="container">

    <!-- HEADER -->

    <div class="top">

        <div class="title">

            <h1>QR Apply History</h1>

            <p>
                View all scanned QR codes and rewards history
            </p>

        </div>

        <div class="search-area">

            <input
                type="text"
                id="search-bar"
                placeholder="Search 9-digit QR Code"
            >

            <button id="search-btn">
                Search
            </button>

        </div>

    </div>

    <!-- FILTERS -->

    <div class="filters">

        <div class="filter-box">

            <label>Start Date</label>

            <input
                type="date"
                id="start-date"
            >

        </div>

        <div class="filter-box">

            <label>End Date</label>

            <input
                type="date"
                id="end-date"
            >

        </div>

    </div>

    <!-- SUMMARY -->

    <div class="summary">

        <div class="summary-card">

            <h3>Total Points</h3>

            <p id="total-points">0</p>

        </div>

        <div class="summary-card">

            <h3>Total QR Scanned</h3>

            <p id="total-scanned">0</p>

        </div>

    </div>

    <!-- TABLE -->

    <div class="table-wrapper">

        <div class="table-scroll">

            <table>

                <thead>

                    <tr>
                        <th>Date Scanned</th>
                        <th>QR Batch</th>
                        <th>QR Code</th>
                        <th>Points</th>
                    </tr>

                </thead>

                <tbody id="coupon-table-body">

                    <% coupons.forEach(function(coupon) { %>

                        <tr class="coupon-row">

                            <td><%= coupon.dateScanned %></td>

                            <td>
                                <span class="badge">
                                    <%= coupon.qrBatch %>
                                </span>
                            </td>

                            <td><%= coupon.qrCode %></td>

                            <td>₹<%= coupon.points %></td>

                        </tr>

                    <% }); %>

                </tbody>

            </table>

        </div>

    </div>

</div>

<script>

const coupons = <%- JSON.stringify(coupons) %>;

const couponTableBody =
    document.getElementById("coupon-table-body");

const totalPoints =
    document.getElementById("total-points");

const totalScanned =
    document.getElementById("total-scanned");

const searchBar =
    document.getElementById("search-bar");

const searchBtn =
    document.getElementById("search-btn");

const startDateInput =
    document.getElementById("start-date");

const endDateInput =
    document.getElementById("end-date");

/* SEARCH */

function searchCoupons(){

    const searchTerm =
        searchBar.value.trim();

    const filteredCoupons =
        coupons.filter(coupon =>
            coupon.qrCode.includes(searchTerm)
        );

    displayCoupons(filteredCoupons);
}

/* DATE FILTER */

function filterByDateRange(){

    const startDate =
        startDateInput.value;

    const endDate =
        endDateInput.value;

    const filteredCoupons =
        coupons.filter(coupon => {

            const couponDate =
                coupon.dateScanned;

            const startMatch =
                !startDate ||
                couponDate >= startDate;

            const endMatch =
                !endDate ||
                couponDate <= endDate;

            return startMatch && endMatch;

        });

    displayCoupons(filteredCoupons);
}

/* DISPLAY */

function displayCoupons(filteredCoupons){

    couponTableBody.innerHTML = "";

    let totalPointsValue = 0;

    filteredCoupons.forEach(function(coupon){

        const row =
            document.createElement("tr");

        row.innerHTML = `

            <td>${coupon.dateScanned}</td>

            <td>
                <span class="badge">
                    ${coupon.qrBatch}
                </span>
            </td>

            <td>${coupon.qrCode}</td>

            <td>₹${coupon.points}</td>

        `;

        couponTableBody.appendChild(row);

        totalPointsValue += Number(coupon.points);

    });

    totalPoints.innerText =
        totalPointsValue;

    totalScanned.innerText =
        filteredCoupons.length;
}

/* EVENTS */

searchBtn.addEventListener(
    "click",
    searchCoupons
);

searchBar.addEventListener(
    "keyup",
    searchCoupons
);

startDateInput.addEventListener(
    "input",
    filterByDateRange
);

endDateInput.addEventListener(
    "input",
    filterByDateRange
);

/* INITIAL */

displayCoupons(coupons);

</script>

</body>

</html>