<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Withdrawal Requests</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:'Inter',sans-serif;
    background:#f4f7fb;
    color:#111827;
    padding:20px;
}

/* Page */

.page-container{
    max-width:1400px;
    margin:auto;
}

/* Top */

.top-bar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
    margin-bottom:25px;
    flex-wrap:wrap;
}

.heading{
    font-size:32px;
    font-weight:700;
    color:#0f172a;
}

/* Summary */

.summary-container{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
    margin-bottom:25px;
}

.summary-box{
    background:white;
    border-radius:22px;
    padding:22px;
    box-shadow:0 10px 30px rgba(15,23,42,0.06);
}

.summary-box h3{
    font-size:15px;
    color:#64748b;
    margin-bottom:10px;
}

.summary-box p{
    font-size:30px;
    font-weight:700;
    color:#2563eb;
}

/* Table */

.table-container{
    background:white;
    border-radius:24px;
    overflow:hidden;
    box-shadow:0 10px 30px rgba(15,23,42,0.06);
}

.table-wrapper{
    overflow-x:auto;
}

table{
    width:100%;
    border-collapse:collapse;
}

thead{
    background:#2563eb;
}

thead th{
    padding:18px;
    text-align:left;
    color:white;
    font-size:14px;
    font-weight:600;
    white-space:nowrap;
}

tbody tr{
    border-bottom:1px solid #eef2f7;
    transition:.2s;
}

tbody tr:hover{
    background:#f8fbff;
}

tbody td{
    padding:18px;
    font-size:14px;
    color:#334155;
    white-space:nowrap;
}

/* Status */

.status-box{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-width:110px;
    padding:10px 14px;
    border-radius:999px;
    font-size:13px;
    font-weight:600;
}

.success{
    background:#dcfce7;
    color:#166534;
}

.failed{
    background:#fee2e2;
    color:#991b1b;
}

.pending{
    background:#fef3c7;
    color:#92400e;
}

/* Pagination */

.pagination{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:10px;
    margin-top:25px;
    flex-wrap:wrap;
}

.page-btn{
    border:none;
    background:white;
    padding:12px 16px;
    border-radius:12px;
    cursor:pointer;
    font-weight:600;
    box-shadow:0 4px 15px rgba(15,23,42,0.06);
    transition:.2s;
}

.page-btn:hover{
    background:#2563eb;
    color:white;
}

.page-btn.active{
    background:#2563eb;
    color:white;
}

/* Empty */

.empty-box{
    padding:60px 20px;
    text-align:center;
    color:#64748b;
}

/* Mobile */

@media(max-width:768px){

    body{
        padding:14px;
    }

    .heading{
        font-size:24px;
    }

    .summary-box p{
        font-size:24px;
    }

    thead th,
    tbody td{
        padding:14px;
        font-size:13px;
    }

}

</style>
</head>

<body>

<div class="page-container">

    <div class="top-bar">
        <h1 class="heading">Withdrawal Requests</h1>
    </div>

    <div class="summary-container">

        <div class="summary-box">
            <h3>Total Withdrawals</h3>
            <p id="totalWithdrawals">0</p>
        </div>

        <div class="summary-box">
            <h3>Total Amount</h3>
            <p>₹<span id="totalAmount">0</span></p>
        </div>

    </div>

    <div class="table-container">

        <% if (withdrawals && withdrawals.length > 0) { %>

        <div class="table-wrapper">

            <table>

                <thead>
                    <tr>
                        <th>Mobile Number</th>
                        <th>Transfer ID</th>
                        <th>Amount</th>
                        <th>Date</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody id="withdrawTableBody">
                </tbody>

            </table>

        </div>

        <% } else { %>

        <div class="empty-box">
            No withdrawal requests found.
        </div>

        <% } %>

    </div>

    <div class="pagination" id="pagination"></div>

</div>

<script>

const withdrawals = <%- JSON.stringify(withdrawals) %>;

/* Latest First */

withdrawals.sort((a, b) => {
    return new Date(b.created_at) - new Date(a.created_at);
});

/* Summary */

document.getElementById("totalWithdrawals").innerText = withdrawals.length;

const totalAmount = withdrawals.reduce((sum, item) => {
    return sum + Number(item.transfer_amount || 0);
}, 0);

document.getElementById("totalAmount").innerText = totalAmount;

/* Pagination */

const rowsPerPage = 15;
let currentPage = 1;

function displayTable(page){

    const tableBody = document.getElementById("withdrawTableBody");

    tableBody.innerHTML = "";

    const start = (page - 1) * rowsPerPage;
    const end = start + rowsPerPage;

    const paginatedItems = withdrawals.slice(start, end);

    paginatedItems.forEach(withdrawal => {

        const tr = document.createElement("tr");

        let statusClass = "pending";

        if(withdrawal.status === "SUCCESS"){
            statusClass = "success";
        }
        else if(
            withdrawal.status === "FAILED" ||
            withdrawal.status === "REJECTED"
        ){
            statusClass = "failed";
        }

        tr.innerHTML = `
            <td>${withdrawal.mobileNumber}</td>
            <td>${withdrawal.transfer_id}</td>
            <td>₹${withdrawal.transfer_amount}</td>
            <td>${new Date(withdrawal.created_at).toLocaleString()}</td>
            <td>
                <div class="status-box ${statusClass}">
                    ${withdrawal.status}
                </div>
            </td>
        `;

        tableBody.appendChild(tr);

    });

}

function setupPagination(){

    const pagination = document.getElementById("pagination");

    pagination.innerHTML = "";

    const pageCount = Math.ceil(withdrawals.length / rowsPerPage);

    for(let i = 1; i <= pageCount; i++){

        const button = document.createElement("button");

        button.innerText = i;

        button.classList.add("page-btn");

        if(i === currentPage){
            button.classList.add("active");
        }

        button.addEventListener("click", () => {

            currentPage = i;

            displayTable(currentPage);

            setupPagination();

        });

        pagination.appendChild(button);

    }

}

/* Initial */

displayTable(currentPage);

setupPagination();

</script>

</body>
</html>