<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Dashboard</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:'Inter',sans-serif;
    background:#f5f7fb;
    color:#111827;
    min-height:100vh;
}

.container{
    max-width:1280px;
    margin:auto;
    padding:28px 22px 60px;
}

/* TOPBAR */

.topbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:28px;
    gap:16px;
}

.brand{
    display:flex;
    align-items:center;
    gap:14px;
    min-width:0;
}

.logo{
    width:120px;
    object-fit:contain;
}

.brand-text{
    display:flex;
    flex-direction:column;
    min-width:0;
}

.company-name{
    font-size:24px;
    font-weight:800;
    color:#111827;
    line-height:1.1;
    white-space:nowrap;
}

.company-tag{
    font-size:13px;
    color:#64748b;
    margin-top:4px;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
}

.logout-btn{
    height:46px;
    padding:0 22px;
    border:none;
    border-radius:14px;
    background:#ffffff;
    color:#ef4444;
    font-weight:700;
    cursor:pointer;
    box-shadow:0 8px 24px rgba(15,23,42,.05);
    transition:.25s;
}

.logout-btn:hover{
    transform:translateY(-2px);
}

/* HERO */

.hero{
    background:#ffffff;
    border-radius:34px;
    padding:34px;
    box-shadow:0 20px 50px rgba(15,23,42,.05);
    margin-bottom:24px;
    border:1px solid #eef2f7;
}

.hero-top{
    display:flex;
    justify-content:space-between;
    gap:20px;
    flex-wrap:wrap;
    margin-bottom:28px;
}

.hero-left h1{
    font-size:36px;
    font-weight:800;
    color:#0f172a;
    margin-bottom:10px;
}

.hero-left p{
    color:#64748b;
    font-size:15px;
    line-height:1.7;
}

.live-badge{
    height:42px;
    padding:0 18px;
    border-radius:999px;
    display:flex;
    align-items:center;
    gap:10px;
    font-size:14px;
    font-weight:700;
}

.live-active{
    background:#ecfdf3;
    color:#16a34a;
}

.live-inactive{
    background:#fef2f2;
    color:#dc2626;
}

.dot{
    width:10px;
    height:10px;
    border-radius:50%;
}

.live-active .dot{
    background:#22c55e;
}

.live-inactive .dot{
    background:#ef4444;
}

/* BALANCE */

.balance-wrapper{
    display:grid;
    grid-template-columns:1.5fr 1fr;
    gap:22px;
}

.balance-card{
    background:linear-gradient(135deg,#111827,#1f2937);
    border-radius:30px;
    padding:30px;
    color:white;
    position:relative;
    overflow:hidden;
}

.balance-card::before{
    content:"";
    position:absolute;
    width:260px;
    height:260px;
    background:rgba(255,255,255,.05);
    border-radius:50%;
    right:-100px;
    top:-100px;
}

.balance-title{
    font-size:15px;
    opacity:.75;
    margin-bottom:14px;
}

.balance-amount{
    font-size:54px;
    font-weight:800;
    margin-bottom:26px;
    letter-spacing:-2px;
}

.balance-actions{
    display:flex;
    gap:16px;
    flex-wrap:wrap;
}

.action-btn{
    flex:1;
    min-width:170px;
    height:58px;
    border-radius:18px;
    text-decoration:none;
    -webkit-tap-highlight-color: transparent;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:12px;
    font-weight:700;
    transition:.25s;
}

.action-btn img{
    width:22px;
    height:22px;
}

.withdraw-btn{
    background:white;
    color:#111827;
}

.scan-btn{
    background:rgba(255,255,255,.1);
    border:1px solid rgba(255,255,255,.1);
    color:white;
}

.action-btn:hover{
    transform:translateY(-2px);
}

/* MINI CARDS */

.mini-grid{
    display:grid;
    grid-template-columns:1fr;
    gap:18px;
}

.mini-card{
    background:#ffffff;
    border-radius:26px;
    padding:24px;
    border:1px solid #eef2f7;
    box-shadow:0 12px 32px rgba(15,23,42,.04);
}

.mini-label{
    font-size:14px;
    color:#64748b;
    margin-bottom:10px;
}

.mini-value{
    font-size:28px;
    font-weight:800;
}

.green{
    color:#16a34a;
}

.red{
    color:#dc2626;
}

/* ANALYTICS */

.analytics-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
    gap:18px;
    margin-top:22px;
}

.analytics-card{
    background:#ffffff;
    border-radius:28px;
    padding:26px;
    border:1px solid #eef2f7;
    box-shadow:0 12px 30px rgba(15,23,42,.04);
}

.analytics-card.dark{
    background:linear-gradient(135deg,#4f46e5,#7c3aed);
    color:white;
    border:none;
}

.analytics-label{
    font-size:14px;
    color:#64748b;
    margin-bottom:12px;
    font-weight:600;
}

.analytics-card.dark .analytics-label,
.analytics-card.dark .analytics-text{
    color:rgba(255,255,255,.7);
}

.analytics-value{
    font-size:34px;
    font-weight:800;
    margin-bottom:10px;
}

.analytics-text{
    font-size:13px;
    color:#94a3b8;
}

/* SECTION */

.section-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin:34px 0 20px;
}

.section-header h2{
    font-size:24px;
    font-weight:800;
}

.section-header span{
    color:#64748b;
    font-size:14px;
}

/* QUICK ACTIONS */

.quick-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
    gap:20px;
}

.quick-card{
    background:#ffffff;
    border-radius:30px;
    padding:28px;
    text-decoration:none;
    border:1px solid #eef2f7;
    box-shadow:0 15px 35px rgba(15,23,42,.04);
    transition:.28s;
    position:relative;
    overflow:hidden;
}

.quick-card:hover{
    transform:translateY(-5px);
}

.quick-card::before{
    content:"";
    position:absolute;
    width:130px;
    height:130px;
    background:#f8fafc;
    border-radius:50%;
    right:-60px;
    top:-60px;
}

.quick-content{
    position:relative;
    z-index:2;
}

.quick-icon{
    width:72px;
    height:72px;
    border-radius:24px;
    background:#f1f5f9;
    display:flex;
    align-items:center;
    justify-content:center;
    margin-bottom:22px;
}

.quick-icon img{
    width:34px;
    height:34px;
}

.quick-title{
    font-size:20px;
    font-weight:800;
    color:#111827;
    margin-bottom:8px;
}

.quick-text{
    color:#64748b;
    line-height:1.7;
    font-size:14px;
}

/* FOOTER INFO BAR */

.info-grid{
    margin-top:40px;
    background:#ffffff;
    border:1px solid #eef2f7;
    border-radius:24px;
    padding:22px 28px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:24px;
    box-shadow:0 10px 30px rgba(15,23,42,.04);
}

.info-card{
    display:flex;
    align-items:center;
    gap:14px;
    flex:1;
}

.info-icon{
    width:52px;
    height:52px;
    min-width:52px;
    border-radius:16px;
    background:#f1f5f9;
    display:flex;
    align-items:center;
    justify-content:center;
}

.info-icon img{
    width:24px;
    height:24px;
}

.info-content{
    display:flex;
    flex-direction:column;
}

.info-title{
    font-size:15px;
    font-weight:700;
    color:#111827;
    margin-bottom:3px;
}

.info-text{
    font-size:13px;
    color:#64748b;
    line-height:1.5;
}

/* MOBILE */

@media(max-width:768px){

    .container{
        padding:18px 14px 40px;
    }

    .topbar{
        margin-bottom:20px;
    }

 .logo{
    width:72px;
}

.company-name{
    font-size:18px;
}

.company-tag{
    font-size:11px;
}

    .logout-btn{
        height:42px;
        border-radius:12px;
        padding:0 16px;
        font-size:13px;
    }

    .hero{
        border-radius:26px;
        padding:24px;
    }

    .hero-left h1{
        font-size:28px;
    }

    .balance-wrapper{
        grid-template-columns:1fr;
    }

    .balance-card{
        border-radius:26px;
        padding:24px;
    }

    .balance-amount{
        font-size:42px;
    }

  .balance-actions{
    display:flex;
    gap:16px;
    flex-wrap:nowrap;
}

.action-btn{
    flex:1;
    min-width:0;
    height:54px;
    border-radius:16px;
    font-size:14px;
}

    .mini-card{
        border-radius:22px;
    }

    .quick-grid{
        grid-template-columns:1fr 1fr;
        gap:14px;
    }

    .quick-card{
        border-radius:22px;
        padding:20px;
    }

    .quick-icon{
        width:58px;
        height:58px;
        border-radius:18px;
        margin-bottom:18px;
    }

    .quick-icon img{
        width:28px;
        height:28px;
    }

    .quick-title{
        font-size:15px;
    }

    .quick-text{
        font-size:12px;
    }

    .info-grid{
        flex-direction:column;
        align-items:flex-start;
        padding:20px;
        gap:18px;
        border-radius:20px;
    }

    .info-card{
        width:100%;
    }

}

</style>

</head>

<body>

<%
const isInactive = userData && userData.status === 'inactive';
%>

<div class="container">

   <div class="topbar">

    <div class="brand">

        <img src="/logo.png" class="logo">

        <div class="brand-text">

            <div class="company-name">
                PentaCore Demo 
            </div>

            <div class="company-tag">
                Digitalized Reward Platform
            </div>

        </div>

    </div>

    <form action="/user/logout" method="POST">
        <button class="logout-btn" type="submit">
            Logout
        </button>
    </form>

</div>

    <div class="hero">

        <div class="hero-top">

            <div class="hero-left">

                <h1>
                    Hi <%= userName %> 👋
                </h1>

                <p>
                    Welcome back. Manage rewards, scan QR codes and withdraw earnings instantly.
                </p>

            </div>

            <div class="live-badge <%= isInactive ? 'live-inactive' : 'live-active' %>">

                <div class="dot"></div>

                <%= isInactive ? 'Rewards Inactive' : 'Rewards Active' %>

            </div>

        </div>

        <div class="balance-wrapper">

            <div class="balance-card">

                <div class="balance-title">
                    Available Balance
                </div>

                <div class="balance-amount">
                    ₹<%= (isNaN(walletBalance) ? 0 : parseFloat(walletBalance)).toFixed(2) %>
                </div>

                <div class="balance-actions">

                    <a href="/user/withdraw" class="action-btn withdraw-btn">

                        <img src="https://img.icons8.com/ios-filled/50/111827/wallet.png">

                        Withdraw

                    </a>

                    <a href="/user/scan-qr" class="action-btn scan-btn">

                        <img src="https://img.icons8.com/ios-filled/50/ffffff/qr-code.png">

                        Scan QR

                    </a>

                </div>

            </div>

            <div class="mini-grid">

                <div class="mini-card">

                    <div class="mini-label">
                        Wallet Status
                    </div>

                    <div class="mini-value <%= isInactive ? 'red' : 'green' %>">
                        <%= isInactive ? 'Inactive' : 'Active' %>
                    </div>

                </div>

                <div class="mini-card">

                    <div class="mini-label">
                        Reward System
                    </div>

                    <div class="mini-value <%= isInactive ? 'red' : 'green' %>">
                        <%= isInactive ? 'Stopped' : 'Running' %>
                    </div>

                </div>

            </div>

        </div>

        <div class="analytics-grid">

          <div class="analytics-card dark">

    <div class="analytics-label">
        Total Coupons Scanned
    </div>

    <div class="analytics-value">
        <%= totalCouponsScanned || 0 %>
    </div>

    <div class="analytics-text">
        Successfully redeemed coupons
    </div>

</div>
            <div class="analytics-card">

                <div class="analytics-label">
                    Account Status
                </div>

                <div class="analytics-value <%= isInactive ? 'red' : 'green' %>">
                    <%= isInactive ? 'Disabled' : 'Verified' %>
                </div>

                <div class="analytics-text">
                    <%= isInactive ? 'Contact support team' : 'All services active' %>
                </div>

            </div>

        </div>

    </div>

    <div class="section-header">

        <h2>
            Quick Access
        </h2>

        <span>
            Manage your account
        </span>

    </div>

    <div class="quick-grid">

        <a href="/user/schemes" class="quick-card">

            <div class="quick-content">

                <div class="quick-icon">
                    <img src="https://img.icons8.com/ios-filled/50/111827/discount.png">
                </div>

                <div class="quick-title">
                    Schemes
                </div>

                <div class="quick-text">
                    View latest offers and reward campaigns.
                </div>

            </div>

        </a>

        <a href="/user/qr-apply-history" class="quick-card">

            <div class="quick-content">

                <div class="quick-icon">
                    <img src="https://img.icons8.com/ios-filled/50/111827/time-machine.png">
                </div>

                <div class="quick-title">
                    QR History
                </div>

                <div class="quick-text">
                    View all scanned QR activity.
                </div>

            </div>

        </a>

        <a href="/user/user-withdraw" class="quick-card">

            <div class="quick-content">

                <div class="quick-icon">
                    <img src="https://img.icons8.com/ios-filled/50/111827/money-transfer.png">
                </div>

                <div class="quick-title">
                    Withdrawals
                </div>

                <div class="quick-text">
                    Track withdrawal history and status.
                </div>

            </div>

        </a>

        <a href="/user/edit-details" class="quick-card">

            <div class="quick-content">

                <div class="quick-icon">
                    <img src="https://img.icons8.com/ios-filled/50/111827/user.png">
                </div>

                <div class="quick-title">
                    Bank Details
                </div>

                <div class="quick-text">
                    Update bank account and profile details.
                </div>

            </div>

        </a>

    </div>

    <!-- FOOTER INFO BAR -->

    <div class="info-grid">

        <div class="info-card">

            <div class="info-icon">
                <img src="https://img.icons8.com/ios-filled/50/111827/security-checked.png">
            </div>

            <div class="info-content">

                <div class="info-title">
                    Secure Wallet
                </div>

                <div class="info-text">
                    Protected reward system and secure transactions.
                </div>

            </div>

        </div>

        <div class="info-card">

            <div class="info-icon">
                <img src="https://img.icons8.com/ios-filled/50/111827/lightning-bolt.png">
            </div>

            <div class="info-content">

                <div class="info-title">
                    Fast Withdrawals
                </div>

                <div class="info-text">
                    Quick bank transfers with realtime processing.
                </div>

            </div>

        </div>

        <div class="info-card">

            <div class="info-icon">
                <img src="https://img.icons8.com/ios-filled/50/111827/gift.png">
            </div>

            <div class="info-content">

                <div class="info-title">
                    Bonus Rewards
                </div>

                <div class="info-text">
                    Earn cashback and special promotional rewards.
                </div>

            </div>

        </div>

    </div>

</div>

</body>
</html>
